# 复制为 .env 后填写；.env 已被 .gitignore 忽略，不要提交。
# 写手、去 AI 味、选题都用 MiniMax（固定 MiniMax-M3.1-Flash，deai 可用 --model 指定 MiniMax-M3）。
MINIMAX_API_KEY=
# 可选：自定义 API 地址（默认 MiniMax 官方地址）
# BESTSELLER__LLM__WRITER__API_BASE=

# 可选：docker compose 参数
# BOOKWEB_PORT=8787            # 浏览器访问端口
# BOOKWEB_BUDGET_USD=20        # 网页里所有书累计花费上限（美元），到顶自动暂停
# BOOKS_HOST_DIR=./books       # 书稿目录
