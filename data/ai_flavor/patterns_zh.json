  "rhythm_rules": [
    {
      "id": "cn.rhythm.choppy",
      "category": "choppy_rhythm",
      "severity": "warn",
      "why": "句法节奏单调：整段被剁成等长短句堆叠，缺长短交错与连接，读起来像AI文案/伪文学断句",
      "min_sentences": 3,
      "short_sentence_chars": 8,
      "choppy_mean_chars": 11,
      "short_run_threshold": 4
    }
  ],
  "discourse_rules": [
    {
      "id": "cn.discourse.face_emotion",
      "category": "face_emotion_label",
      "severity": "warn",
      "threshold": 3,
      "pattern": "(?:脸色|面色|神色|脸)[^。！？\\n]{0,2}(?:骤变|大变|一变|铁青|铁灰|煞白|惨白|发白|发青|苍白|青白|阴沉)",
      "why": "「脸色X」成语化脸色词贴情绪标签(脸色骤变/面色铁青/青白交加)——看似外显实则贴标签。换成一个具体非成语的面部或身体动作(嘴唇抖/喉头滚/指节掐进掌心/眼神钉住)"
    },
    {
      "id": "cn.discourse.empty_hands",
      "category": "empty_reaction_shot",
      "severity": "warn",
      "threshold": 1,
      "pattern": "(?:袖中)?(?:交叠的)?(?:双手|十指)[^，。！？\\n]{0,4}(?:分开|松开了?)",
      "why": "'双手分开/十指松开'是含义模糊的无效反应镜头(读者读不出代表什么)。换成被打断的意图动作或不受控的生理反应（要落的笔停在半空、握着的东西掐进掌心）"
    },
    {
      "id": "cn.discourse.crowd_cadence",
      "category": "crowd_reaction_beat",
      "severity": "warn",
      "threshold": 2,
      "pattern": "谁(?:也|都)不(?:想|敢|愿)",
      "why": "'谁也不想/谁都不敢…'群体反应句式重复——好手法用滥成新套路。每场最多一次，其余改成某个具体人的具体动作"
    },
    {
      "id": "cn.discourse.crowd_beat",
      "category": "crowd_reaction_beat",
      "severity": "warn",
      "threshold": 3,
      "pattern": "[堂场][上中][^。！？\\n]{0,8}(?:有人|众人|众弟子)[^。！？\\n]{0,6}(?:吸气|倒抽|惊呼|低呼|哦|啊|骚动|嗤|嘀咕|应和)",
      "why": "群体反应 beat 重复——「堂上有人吸气/哦/啊」连发当反应，成套路且替读者下'此刻很震撼'的判断。每场最多一次，且要落到一个具体的人一个具体动作"
    },
    {
      "id": "cn.discourse.neg_action",
      "category": "negative_action_filler",
      "severity": "warn",
      "threshold": 4,
      "pattern": "(?:他|她|它)没(?:有)?(?:去)?[一-鿿]{1,3}(?=[。，,！？\\n])",
      "why": "「他没X」否定式克制做反应过密(没动声/没抬头/没接话)——填充感，假装沉稳实则没传达。要么删，要么换正向带戏剧载荷的动作；反预期的'不做'(众人等他研、他偏不研)可保留"
    },
    {
      "id": "cn.info.rule_clause",
      "category": "info_narration",
      "severity": "warn",
      "threshold": 1,
      "pattern": "(?:凡[^。！？\\n]{1,12}?者[，,]?[^。！？\\n]{0,6}?(?:[须必]|不得)[一-鿿])|(?:[^，。！？\\n]{2,8}者[，,]?[^。！？\\n]{0,4}?不得(?:入|出|动|言|语|议|为))|(?:[^，。！？\\n]{2,6}[，,][^，。！？\\n]{0,6}(?:司|院|堂|处)[^，。！？\\n]{0,5}(?:点人|议事)[才]?用)|(?:[诸众][^，。！？\\n]{0,4}必须[^，。！？\\n]{0,8}(?:活计|差遣|放下))",
      "why": "叙述者解说规则/术语/职能（凡X者须/X者不得/X司点人用）——删解说，让规则从人物反应、对白、后果里透出来"
    },
    {
      "id": "cn.info.parallel_gloss",
      "category": "info_narration",
      "severity": "warn",
      "threshold": 1,
      "pattern": "([一-鿿]{1,2})的是[^，。！？\\n]{1,8}[，,]\\1的是",
      "why": "对仗式排比下定义（验的是X，验的是Y）——旁白装腔，改成具体动作或直接陈述"
    },
    {
      "id": "cn.translationese.dui_jinxing",
      "category": "translationese",
      "severity": "warn",
      "threshold": 1,
      "pattern": "对[^。！？，,\\n]{1,12}进行了?[一-鿿]",
      "why": "「对X进行Y」把动词名词化再用空动词激活——机翻腔。还原成直接动词（对阵法进行了修复→把阵法修好了）"
    },
    {
      "id": "cn.translationese.shi_dedao",
      "category": "translationese",
      "severity": "warn",
      "threshold": 1,
      "pattern": "(?<![即假纵倘])使[^。！？，,\\n]{1,10}得到了?",
      "why": "「使X得到Y」欧化空转句式——还原成主动直陈（使他的剑意得到淬炼→他的剑意磨得更利了）"
    },
    {
      "id": "cn.translationese.bei_adverbial",
      "category": "translationese",
      "severity": "warn",
      "threshold": 1,
      "pattern": "被[^。！？，,\\n]{0,8}(?:很好地|成功地|有效地|完美地|彻底地|充分地|妥善地|巧妙地)",
      "why": "评价式被字句（被…很好地/成功地…）——翻译腔。中文多用主动：这个问题我们修好了。动作被字句（被一掌拍飞）是地道中文，不在此列"
    },
    {
      "id": "cn.translationese.bei_suo",
      "category": "translationese",
      "severity": "warn",
      "threshold": 2,
      "pattern": "被[^。！？，,\\n]{1,6}所[一-鿿]{1,3}",
      "why": "「被X所Y」文白混搭被动式过密（被恐惧所支配/被剑光所摄）——AI仙侠高发腔。改主动或去「所」，一章最多留一处"
    },
    {
      "id": "cn.translationese.zuowei_yige",
      "category": "translationese",
      "severity": "warn",
      "threshold": 1,
      "pattern": "作为一[个名位][^。！？\\n]{1,14}[，,]",
      "why": "「作为一个X，…」是英文 As a... 的直译开头——改成中文语序（作为一个散修，他…→他是散修，…／散修出身的他…）"
    },
    {
      "id": "cn.discourse.dash_density",
      "category": "dash_density",
      "severity": "warn",
      "pattern": "——",
      "per_1k_threshold": 4.0,
      "escalate_per_1k": 10.0,
      "escalate_category": "dash_train",
      "why": "破折号密度超出人类写作区间——AI最扎眼的标点痕迹。实测 1187 篇真实出版章：中位 0/千字、p99=3.85/千字；本章已越过 p99。按其职能替换：停顿改句号/逗号、补充改括号、引出改冒号；全章留一两处真正需要的转折即可",
      "min_chars": 1200,
      "threshold": 4
    },
    {
      "id": "cn.discourse.then_now",
      "category": "then_now_contrast",
      "severity": "warn",
      "threshold": 3,
      "pattern": "(?:以前|从前|过去|曾经)[^。！？\\n]{1,24}(?:现在|如今|而今)",
      "why": "「以前…现在…」时间对比骨架反复用——AI爱用的对比推进节奏。直接写现在怎样，把「以前」压成半句或删掉"
    },
    {
      "id": "cn.discourse.adj_colon",
      "category": "adjective_colon_verdict",
      "severity": "warn",
      "threshold": 2,
      "pattern": "(?:很|极其|相当|太)[一-鿿]{1,4}[：:](?![「『“‘\"'])",
      "why": "「形容词+冒号」替读者下判断（答案很简单：/问题很直接：）——删掉定性词让事实自己说话；引入对白的「声音很冷：『滚』」是合法用法，不在此列"
    },
    {
      "id": "cn.discourse.pseudo_precision_len",
      "category": "pseudo_precision",
      "severity": "warn",
      "threshold": 1,
      "pattern": "(?:推|拉|递|移|挪|缩|退|抬|压|送|拧|抽|探|滑|偏|倾|迈|蹭)[了出去进前后开低]{0,2}[一两三半][寸分尺](?!钟)|一寸一寸",
      "why": "动作幅度量化=伪精确（人类语料4494万字0命中；读者分不出半寸和一寸）。具体≠量化：幅度用瞬时态（往前一推/一把夺过）或后果（纸角戳到对方胸口）。注意「退一步/敲两下/几下」是人类正常写法，不在此列；剧情需要精确证据（侦探取证）除外"
    },
    {
      "id": "cn.discourse.pseudo_precision_time",
      "category": "pseudo_precision",
      "severity": "warn",
      "threshold": 1,
      "pattern": "(?:停|顿|沉默|愣|看|盯|数|等|站|坐|想)了[一两二三四五数几]秒|(?:停|顿|等)(?:了)?[一两半]拍",
      "why": "停顿/动作用钟表计时=伪精确（人类0.7/百万字，「慢半拍」熟语与仙侠「数息」不在此列）。改「半晌/片刻」，或干脆直接切下一个动作"
    },
    {
      "id": "cn.discourse.pseudo_precision_turn",
      "category": "pseudo_precision",
      "severity": "warn",
      "threshold": 1,
      "pattern": "[拧旋][了动过]?半圈",
      "why": "「拧了半圈」类角度计量=伪精确（人类0.3/百万字）。写瞬时态（猛地一拧）或后果（锁芯咔哒咬死）"
    },
    {
      "id": "cn.discourse.moment_slice",
      "category": "moment_slice",
      "severity": "warn",
      "pattern": "[一-鿿]{1,6}的那一瞬(?:间)?|[一两三半][寸分步息拍瞬]里",
      "per_1k_threshold": 1.2,
      "escalate_per_1k": 3.0,
      "escalate_category": "moment_slice_train",
      "min_chars": 1200,
      "threshold": 3,
      "why": "改法：把被切成多个瞬间接力推进的动作链合并回正常叙述——一个动作一句写完，整章最多保留一处真正的转折瞬间；合并后少掉的字数用新事件、对话或后果补足，不许用更细的分解镜头补。这类句法在真实出版语料里 99.6% 的章节完全不出现，是注水最典型的形态"
    },
    {
      "id": "cn.discourse.stock_reaction",
      "category": "stock_reaction",
      "severity": "warn",
      "threshold": 4,
      "per_1k_threshold": 0.7,
      "min_chars": 1200,
      "pattern": "(?:指尖|手指|指节|手背|掌心|拳头|袖口|衣角|裙角|下唇|嘴唇|唇角|嘴角|眉头|眼底|眸光|目光|视线|肩膀|呼吸)[^。！？!?\\n]{0,16}(?:轻轻|微微|缓缓|悄然|不自觉|无意识|下意识|攥紧|握紧|收紧|绞紧|泛白|发白|叩|敲|摩挲|抿紧|抿成|移开|垂下|躲开|一颤|颤了?一下|停了?一下|顿了?一下)|(?:语气|声音)[^。！？!?\\n]{0,12}(?:平静|冷静|平淡|冷淡|淡漠|平直)[^。！？!?\\n]{0,12}(?:像|仿佛|如同|好像)[^。！？!?\\n]{0,16}(?:念|读|报|说|陈述|宣判|背诵)|(?:胸口|心口)[^。！？!?\\n]{0,16}(?:像|仿佛|如同|好像)[^。！？!?\\n]{0,16}(?:撞|锤|压|攥|堵)[^。！？!?\\n]{0,8}(?:一下|一记|一拳)?|(?:声音|嗓音|语气)[^。！？!?\\n]{0,12}(?:放轻|压低|发紧|发颤|很轻|轻了些)|(?:喉结|喉头|喉咙)[^。！？!?\\n]{0,10}(?:滚|动|紧|堵|发涩|发干)|(?:眼眶|眼圈|鼻子)[^。！？!?\\n]{0,8}(?:发红|红了|发热|发酸|一酸)|(?:抿了?下唇|抿了?抿唇|抿了?下嘴|抿着笑)",
      "why": "罐头反应镜头：部位+轻微动作/状态的通用情绪尾巴成片出现（指节发白/喉结滚动/声音发紧/语气平静得像在念）——AI 用通用零件拼情绪。2026-08-30 校准（scripts/deai_fusion_calibrate.py，1135 真实出版章 vs 245 淘汰稿）：人类命中率 13.4%、密度 p99=0.59/千字、max 0.93；AI 淘汰稿密度 6.5 倍。阈值取人类 max 之下的 0.7+4 处。修法：删掉只提示读者『这里该感动』的镜头，或换成绑定当下情境、有物理后果的具体反应"
    },
    {
      "id": "cn.discourse.micro_action_tic",
      "category": "micro_action_tic",
      "severity": "warn",
      "threshold": 8,
      "per_1k_threshold": 3.0,
      "min_chars": 1200,
      "pattern": "了(?:[一两三几半])?(?:下(?![去来])|阵|圈|声|眼(?!睛)|口气|会)",
      "why": "「了(一)下/了两声」轻量补语高密度=微动作复读（顿了一下/敲了两下/看了一眼连轴转），电报体指纹。2026-08-30 校准（收窄版：排除「了下去/了下来」趋向补语、「瞪大了眼睛」与「了一道」量词——原 oh-story 正则把这些正常中文也算命中，人类侧虚高）：人类 1033 章 mean=0.52/千字、p99=2.98、max=4.17；AI 淘汰稿 3.2 倍、max 17.4。门=人类 p99：≥8 处且 ≥3.0/千字（人类误报 0.73%、AI 淘汰稿命中 14.3%）。修法：同类微动作只留最有力的一次，其余并进叙述或删除——不是把『了一下』换成『了一瞬』"
    },
    {
      "id": "cn.discourse.reverse_contrast",
      "category": "reverse_contrast",
      "severity": "warn",
      "threshold": 3,
      "per_1k_threshold": 0.4,
      "min_chars": 1200,
      "pattern": "(?<![还只可但于倒像若要正便总老更最算怕凡或即自竟原本仍许净光单尽])是([^。！？!?\\n，,]{1,12})[，,]\\s*不是(?!吗|么|说)([^。！？!?\\n]{1,20})",
      "why": "反序对比排比：「是X，不是Y(，不是Z)」品鉴式否定连排——negated_definition 的反序变体，密度成瘾后每次辨认/揭示都长这个形状。2026-08-30 校准（已排除人类合法的「而不是」比较与「不是吗」反问）：人类命中率 7.1%、p99=0.24/千字、max 0.45；AI 密度 11 倍、p99=1.03。阈值取人类 max 之下 0.40+3 处。修法：直接写它是什么、凭什么认出来的（气味来源/口感细节），最多保留一处真正有辨认张力的对比"
    },
    {
      "id": "cn.discourse.voice_contrast",
      "category": "voice_contrast",
      "severity": "warn",
      "threshold": 2,
      "pattern": "声音(?:并)?不[大高响亮][^。！？!?\\n]{0,16}[却但偏]",
      "why": "音量反差腔：「声音不大/不高，却…」先立音量再转折抬效果。单次是人类常见写法（2026-08-30 校准：人类 1.1% 章有 1 次），聚集≥2 次即模板（AI 密度 5.6 倍）。修法：删掉音量铺垫，直接写这句话落进场子的具体效果（谁停了筷子/哪排人回头）"
    },
    {
      "id": "cn.discourse.trailer_ending",
      "category": "trailer_ending",
      "severity": "warn",
      "threshold": 1,
      "tail_chars": 600,
      "pattern": "没人知道|谁也不知道|谁也没想到|殊不知|(?:这)?才刚刚开(?:始|头)|正(?:朝着|向着)[^。！？!?\\n]{0,24}(?:压|涌|袭|逼)(?:了?过去|了?过来|来)|(?<!正式)拉开(?:序幕|帷幕)|即将(?:开始|来临|降临)",
      "why": "章末预告腔（只扫末 600 字窗口）：叙述者替读者预告下一章走向（谁也没想到/一切才刚刚开始/大战即将来临）——模型满足『章末要有钩子』的最便宜方式。2026-08-30 校准：人类末段命中率 0.9%、本仓 AI 305 份稿 0 命中（绊线轴：当前干净，防换模型/换题材回归；oh-story 的 AI 语料实测 1.3-6.6%）。修法：钩子要具体——用未解决的事实、新出现的物件或停在半空的对话收章，不用旁白预告"
    },
    {
      "id": "cn.discourse.trailer_summary",
      "category": "trailer_summary",
      "severity": "warn",
      "threshold": 1,
      "tail_chars": 600,
      "pattern": "这一(?:夜|天|刻|战|年|局|役)[，,]?[^。！？!?，,\\n]{0,6}(?<!命中)(?<!是)注定[^。！？!?\\n]{0,8}[。！]|就这样[，,][^。！？!?，,\\n]{0,8}(?:一切|全部)[^。！？!?，,\\n]{0,4}(?:结束了|落幕|收场)[。！]|这一切[，,]?[^。！？!?，,\\n]{0,6}(?:都)?(?:说明|意味着|结束了)(?!的)(?:(?!什么)[^。！？!?\\n]){0,6}[。！]|(?:新的篇章|新的旅程|崭新的篇章|新的人生)[^。！？!?\\n]{0,6}(?:开始|拉开|展开)|命运[^。！？!?\\n]{0,6}齿轮",
      "why": "章末盖章腔（只扫末 600 字窗口）：叙述者替本章盖总结章（这一夜注定无人入眠/这一切都结束了/新的人生就此展开）——与预告腔互为表里，一个盖过去一个许未来。2026-08-30 校准：人类末段命中 0/1135、AI 0 命中（绊线轴）；oh-story 真人语料 2 万章章中段仅 0.005%。修法：停在最后一个具体的动作、物件或后果上，让场景自己收束"
    }
  ],
  "terse_tag_rules": [
    {
      "id": "cn.terse_tag.bare",
      "category": "terse_dialogue_tag",
      "severity": "warn",
      "why": "终末裸对白标签过密——单字/极短情绪台词紧跟无动作 beat 的「X说/道」（如「冷。」他说），连续多处读起来像模型腔。改成动作 beat 替代裸标签：先一个物理动作或物件互动，再让台词落下来",
      "max_quote_chars": 3,
      "threshold": 3
    }
  ],
  "staccato_rules": [
    {
      "id": "cn.staccato.saturation",
      "category": "staccato_saturation",
      "severity": "warn",
      "why": "独行短句装腔过饱和：把每个动作/心理拍点单独切成一句一段，整章充斥单句独段，读起来像分镜脚本而非小说叙述。短句独段是偶尔的重锤，不能成为默认节奏",
      "solo_line_max_chars": 40,
      "min_solo_lines": 8,
      "solo_ratio_threshold": 0.25,
      "run_threshold": 5,
      "subject_repeat_threshold": 3
    }
  ]
}
