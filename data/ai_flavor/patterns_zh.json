    {
      "id": "cn.humanizer.negated_parallel.001",
      "pattern": "这?不仅仅是[^。！？\\n]{0,36}(?:而是|更是)",
      "severity": "warn",
      "category": "negated_parallelism",
      "suggestions": [],
      "remove_sentence_on_block": false,
      "why": "Humanizer-zh: 否定式排比过度使用"
    },
    {
      "id": "cn.conclusion.not_but.001",
      "pattern": "(?<![不仅也])不是[^。！？，,\\n]{1,20}[，,][^。！？\\n]{0,8}而是",
      "severity": "warn",
      "category": "negated_definition",
      "suggestions": [],
      "remove_sentence_on_block": false,
      "why": "结论先行·否定式下定义「不是X，而是Y」：叙述者先抛抽象判断替读者下结论。改成让读者从感官/动作/物件自己得出，过程在前结论隐去"
    },
    {
      "id": "cn.conclusion.not_but.002",
      "pattern": "与其说[^。！？\\n]{1,30}不如说",
      "severity": "warn",
      "category": "negated_definition",
      "suggestions": [],
      "remove_sentence_on_block": false,
      "why": "结论先行·「与其说X不如说Y」：叙述者代读者权衡定性。改成展示，不要宣告"
    },
    {
      "id": "cn.conclusion.not_but.003",
      "pattern": "不是[^。！？，,\\n]{1,16}[，,]是[^。！？\\n]",
      "severity": "warn",
      "category": "negated_definition",
      "suggestions": [],
      "remove_sentence_on_block": false,
      "why": "结论先行·「不是X，是Y」逗号变体(描写物件常犯：不是黑墨，是暗金的浓墨)：直接写Y(墨里浮着一丝暗金)"
    },
    {
      "id": "cn.conclusion.not_but.004",
      "pattern": "不是[^。！？，,\\n]{1,12}[。！？]\\s*是[^。！？\\n]",
      "severity": "warn",
      "category": "negated_definition",
      "suggestions": [],
      "remove_sentence_on_block": false,
      "why": "结论先行·「不是X。是Y」句号/跨句变体(不是发芽。是皮壳先裂开)：先否定再下定义。直接写Y那个现象，别由叙述者纠正"
    },
    {
      "id": "cn.conclusion.not_but.005",
      "pattern": "(?:其实)?没什么[^。！？，,\\n]{1,16}[，,]是[^。！？\\n]",
      "severity": "warn",
      "category": "negated_definition",
      "suggestions": [],
      "remove_sentence_on_block": false,
      "why": "结论先行·「其实没什么X，是Y」先否定再翻面，替读者命名情绪。删掉自我解释，让处理物件的选择与后果承担情绪"
    },
    {
      "id": "cn.info.backstory.001",
      "pattern": "那是[^。！？\\n]{0,16}(?:后遗症|的手段|惯用)",
      "severity": "warn",
      "category": "info_narration",
      "suggestions": [],
      "remove_sentence_on_block": false,
      "why": "全知旁白·解释前情/机制(那是…的后遗症/手段)：删解释，只写人物看见的现象，让读者自己拼"
    },
    {
      "id": "cn.info.backstory.002",
      "pattern": "没人(?:看见|知道|注意到|察觉)",
      "severity": "warn",
      "category": "info_narration",
      "suggestions": [],
      "remove_sentence_on_block": false,
      "why": "全知旁白(没人看见/没人知道)：跳出单一视角替读者补背景。换成视角人物此刻一个具体动作或物证"
    },
    {
      "id": "cn.info.backstory.003",
      "pattern": "[一-鿿]{2,5}是[^。！？\\n]{0,8}(?:分下来的|留下的|传下来的)",
      "severity": "warn",
      "category": "info_narration",
      "suggestions": [],
      "remove_sentence_on_block": false,
      "why": "信息陈述·来历交代(X是…分下来的)：档案式交代来历。改成人物此刻摸到/认出它的那一下"
    },
    {
      "id": "cn.info.rule.001",
      "pattern": "(?:堂规|宗规|门规|规矩)[^。！？\\n]{0,6}第[一二三四五六七八九十百零\\d]{1,4}条",
      "severity": "warn",
      "category": "info_narration",
      "suggestions": [],
      "remove_sentence_on_block": false,
      "why": "旁白解释规则条款(堂规第X条)：跳出场景给读者讲规则。让规则从人物的反应/对白/后果里透出来"
    },
    {
      "id": "cn.info.rule.002",
      "pattern": "[一-鿿]{2,4}即[一-鿿]{2,5}[，,][一-鿿]{2,5}即",
      "severity": "warn",
      "category": "info_narration",
      "suggestions": [],
      "remove_sentence_on_block": false,
      "why": "旁白解释路数/意图(先逼落砚，落砚即离身，离身即失势)：叙述者把对方算计逐环讲明。改成只写可见的逼迫动作，算计让读者自己拼"
    },
    {
      "id": "cn.physio.001",
      "pattern": "心跳漏了[一半]拍|心跳漏跳|心跳骤停|心跳漏了一下",
      "severity": "warn",
      "category": "physiological_cliche",
      "suggestions": [],
      "remove_sentence_on_block": false,
      "why": "生理套路(心跳漏了一拍)：万能身体反应陈词。换成一个具体的、跟当下情境绑定的身体动作"
    },
    {
      "id": "cn.physio.002",
      "pattern": "(?:眼瞳|瞳孔)[一猛骤]{0,2}缩了?(?:一下)?|心头猛地一[紧颤沉]",
      "severity": "warn",
      "category": "physiological_cliche",
      "suggestions": [],
      "remove_sentence_on_block": false,
      "why": "生理套路·模板化微动作(眼瞳一缩/心头猛地一紧)：脸谱化身体反应。换成具体可见动作＋与物件互动＋后果"
    },
    {
      "id": "cn.physio.003",
      "pattern": "呼吸[一猛]?[顿停滞滞]了?[半一]?拍|呼吸[一]?[滞窒]",
      "severity": "warn",
      "category": "physiological_cliche",
      "suggestions": [],
      "remove_sentence_on_block": false,
      "why": "生理套路(呼吸顿了半拍/呼吸一滞)：万能身体反应。换成一个具体、跟当下绑定的动作"
    },
    {
      "id": "cn.info.pointbreak.001",
      "pattern": "本该[^。！？\\n]{0,6}(?:枯|死|被|拔|散|崩|碎|输|赢|断|到|在|是|属于)",
      "severity": "warn",
      "category": "info_narration",
      "suggestions": [],
      "remove_sentence_on_block": false,
      "why": "旁白点破(三天苗本该枯在土里/那本该枯死的叶柄)：叙述者替读者点明'本来该如何'。删点破，只写当下现象，反差让读者自己感到"
    },
    {
      "id": "cn.info.pointbreak.002",
      "pattern": "本是[^。！？\\n]{0,10}(?:取巧|为了|为的是|为的)",
      "severity": "warn",
      "category": "info_narration",
      "suggestions": [],
      "remove_sentence_on_block": false,
      "why": "旁白解释用意/技法(袖中研墨本是取巧——不让旁人看见)：叙述者讲明手段目的。删解释，只写人物怎么做"
    },
    {
      "id": "cn.conclusion.with_more.001",
      "pattern": "随着[^。！？\\n]{1,28}越来越",
      "severity": "warn",
      "category": "essay_progression",
      "suggestions": [],
      "remove_sentence_on_block": false,
      "why": "论文/公众号式推进「随着X越来越Y」：小说正文应改成具体事件链、动作后果或场景压力，不用趋势句概括"
    },
    {
      "id": "cn.conclusion.no_matter.001",
