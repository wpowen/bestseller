{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "WritingMethodologyCandidateDeck",
  "type": "object",
  "required": ["candidates"],
  "properties": {
    "candidates": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "candidate_id",
          "source_id",
          "section_id",
          "title",
          "category",
          "scope",
          "stage",
          "core_claim",
          "framework_bindings",
          "confidence"
        ],
        "properties": {
          "candidate_id": { "type": "string", "pattern": "^[a-z0-9_.-]+$" },
          "source_id": { "type": "string", "pattern": "^source-[0-9]{4,}$" },
          "section_id": { "type": "string", "pattern": "^sec-[0-9]{4}$" },
          "title": { "type": "string", "minLength": 1 },
          "category": { "type": "string", "minLength": 1 },
          "scope": { "type": "array", "items": { "type": "string" }, "minItems": 1 },
          "stage": { "type": "array", "items": { "type": "string" }, "minItems": 1 },
          "core_claim": { "type": "string", "minLength": 1 },
          "operating_steps": { "type": "array", "items": { "type": "string" } },
          "anti_patterns": { "type": "array", "items": { "type": "string" } },
          "required_contract_fields": { "type": "array", "items": { "type": "string" } },
          "framework_bindings": { "type": "array", "items": { "type": "string" }, "minItems": 1 },
          "gate_bindings": {
            "type": "array",
            "items": {
              "type": "object",
              "required": ["gate"],
              "properties": {
                "gate": { "type": "string", "minLength": 1 },
                "default_mode": { "type": "string" }
              },
              "additionalProperties": false
            }
          },
          "alignment_terms": { "type": "array", "items": { "type": "string" } },
          "conflicts_with": { "type": "array", "items": { "type": "string" } },
          "confidence": { "type": "number", "minimum": 0, "maximum": 1 }
        },
        "additionalProperties": false
      }
    }
  },
  "additionalProperties": false
}
