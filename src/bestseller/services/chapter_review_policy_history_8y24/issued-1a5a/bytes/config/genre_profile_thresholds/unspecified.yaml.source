# Unknown / unspecified labels carry no genre content authority.
# null means no strength/density target; zero disables payoff quotas/cadence.
# Explicit author profiles and known genre YAMLs keep their existing values.
id: unspecified
name: 未指定题材 (中性阈值)

hook_config:
  preferred_types: []
  strength_baseline: null
  chapter_end_required: false
  transition_allowance: 2

coolpoint_config:
  preferred_patterns: []
  density_per_chapter: null
  combo_interval: 0
  milestone_interval: 0

micropayoff_config:
  preferred_types: []
  min_per_chapter: 0
  transition_min: 0

# Generic operational bounds from PacingThresholds, independent of content.
pacing_config:
  stagnation_threshold: 3
  strand_max_gap:
    overt: 5
    undercurrent: 10
    hidden: 15
    core_axis: 20
  transition_max_consecutive: 2

# Generic OverrideConfig bounds; preserve the explicit override/debt mechanism.
override_config:
  allowed_rationale_types:
    - TRANSITIONAL_SETUP
    - LOGIC_INTEGRITY
    - CHARACTER_CREDIBILITY
    - WORLD_RULE_CONSTRAINT
    - ARC_TIMING
    - GENRE_CONVENTION
    - EDITORIAL_INTENT
  debt_multiplier: 1.0
  payback_window_default: 5
  interest_rate_per_chapter: 0.10
