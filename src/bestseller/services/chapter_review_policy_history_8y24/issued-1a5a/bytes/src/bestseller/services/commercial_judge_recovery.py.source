"""Carry per-slot diagnostics through the existing two-round chapter review.

No scheduling, additional sampling or prose edits live here. Missing provenance
fails closed instead of paying for an identical blind prompt.
"""

from __future__ import annotations

from collections.abc import Mapping
from copy import deepcopy
from functools import wraps
import hashlib
import json
from typing import Any
from uuid import UUID

from bestseller.domain.llm_quality_judge import LLMQualityJudgeResult
from bestseller.services.commercial_review_wire import parse_commercial_wire
from bestseller.services.commercial_source_evidence import CommercialSources

# ruff: noqa: ANN401
SLOT_RECEIPT_SCHEMA = "commercial-slot-evidence.v1"
_BINDING_KEYS = (
    "body_sha256",
    "semantic_source_sha256",
    "previous_sha256",
    "source_protocol_sha256",
)
_EXACT_AUDIT_KEYS = ("body_sha256", "source_sha256", "previous_sha256", "assembled_source_sha256")
_NATIVE_CONCEPTION_ROUTES = frozenset({
    ("critic", "conception_source_effect_contract", None),
    ("critic", "conception_explicit_seed_fidelity_judge", None),
    ("critic", "conception_explicit_seed_fidelity_arbitration", None),
    ("critic", "conception_final_material_seed_fidelity_judge", None),
    ("critic", "conception_reconciled_seed_fidelity_judge", None),
    ("planner", "conception_story_spine_polish", None),
    ("editor", "concept_tournament_winner_seed_repair", None),
    ("editor", "conception_explicit_seed_fidelity_repair", None),
})


def _native_conception_payloads(settings, run):
    """Read explicit JSON-null ownership without changing either physical file."""
    from pathlib import Path

    from bestseller.services import llm
    from bestseller.services import retained_planning_generation as physical

    def need(value):
        if not value:
            raise ValueError("native_conception_physical_unproven")

    need(settings.artifact_store.mode == "local" and run.project_id is None)
    root = Path(settings.artifact_store.local_dir).expanduser().resolve()
    payloads, hashes = {}, {}
    for kind in ("request", "response"):
        reference = getattr(run, kind + "_payload_ref")
        need(isinstance(reference, str) and bool(reference))
        path = (root / reference).resolve()
        need(path.is_relative_to(root))
        raw = path.read_bytes()
        value = json.loads(
            raw, object_pairs_hook=physical._unique, parse_constant=physical._constant
        )
        need(
            isinstance(value, dict)
            and value.get("schema_version") == "llm-payload.v1"
            and value.get("kind") == kind
            and value.get("replayable") is True
            and value.get("replayability_reasons") == []
        )
        need("project_id" in value and value["project_id"] is None)
        for key, expected in (
            ("llm_run_id", str(run.id)),
            ("workflow_run_id", str(run.workflow_run_id)),
            ("logical_role", run.logical_role),
        ):
            need(value.get(key) == expected)
        for key, expected in (
            ("prompt_template", run.prompt_template),
            ("prompt_version", run.prompt_version),
        ):
            if kind == "request" or key in value:
                need(key in value and value[key] == expected)
        if kind == "response":
            need(value.get("model") == run.model_name and value.get("provider") == run.provider)
        json.dumps(value, allow_nan=False)
        payloads[kind], hashes[kind] = value, hashlib.sha256(raw).hexdigest()
    payload = payloads["request"]
    messages = payload.get("messages") or {}
    need(messages.get("source") == "system_user" and messages.get("replayable") is True)
    texts = {}
    for key in ("system", "user"):
        record = messages.get(key) or {}
        value = record.get("text")
        need(
            isinstance(value, str)
            and bool(value)
            and record.get("truncated") is False
            and record.get("original_chars") == len(value)
        )
        texts[key] = value
    requested = payload.get("requested")
    fields = {
        "model_tier",
        "model_catalog_key",
        "temperature_override",
        "max_tokens_override",
        "cache_system",
    }
    need(isinstance(requested, dict) and fields <= requested.keys())
    for key in ("tools", "tool_choice", "messages_override"):
        need(payload.get(key) is None and requested.get(key) is None)
    request = llm.LLMCompletionRequest(
        logical_role=run.logical_role,
        system_prompt=texts["system"],
        user_prompt=texts["user"],
        fallback_response="purpose proof only; never dispatched",
        project_id=None,
        workflow_run_id=run.workflow_run_id,
        step_run_id=None,
        prompt_template=run.prompt_template,
        prompt_version=run.prompt_version,
        **{key: requested[key] for key in fields},
    )
    effective = payload.get("effective")
    need(isinstance(effective, dict))
    return request, payloads["response"], hashes["request"], hashes["response"], effective


def _native_conception_paid_return(root, attempt, transport, run, *, scope, digest):
    """Validate the native paid chain while preserving NULL origin ownership."""
    from bestseller.services import llm

    def need(value):
        if not value:
            raise ValueError("native_conception_paid_unproven")

    execution = (run.metadata_json or {}).get("execution_receipt") or {}
    recorded = execution.get("attempts")
    need(
        root.scope_id == scope
        and root.status == "completed"
        and root.input_hash == digest
        and run.prompt_hash == digest
        and run.provider == llm._provider_from_model(run.model_name)
        and run.provider not in {"mock", "fallback", "test"}
        and execution.get("scope_id") == scope
        and execution.get("operation_key") == root.key
        and isinstance(recorded, list)
        and len(recorded) == 1
        and recorded[0].get("attempt_id") == attempt.id
        and recorded[0].get("status") == "completed"
        and attempt.scope_id == scope
        and attempt.operation_key == root.key
        and attempt.status == "completed"
        and attempt.input_hash == digest
        and attempt.model_name == run.model_name
        and attempt.actual_tokens == run.input_tokens + run.output_tokens
    )
    expected_key = hashlib.sha256(
        f"transport-result.v1\n{scope}\n{attempt.id}".encode()
    ).hexdigest()
    envelope = transport.result_json
    need(
        transport.key == expected_key
        and transport.scope_id == scope
        and transport.status == "transport_result"
        and transport.input_hash == digest
        and isinstance(envelope, Mapping)
        and envelope.get("operation_key") == root.key
        and envelope.get("attempt_id") == attempt.id
        and envelope.get("input_hash") == digest
    )
    paid = llm.LLMCompletionResult.model_validate(envelope.get("result"))
    completed = llm.LLMCompletionResult.model_validate(root.result_json)
    need(
        all(
            getattr(paid, key) == getattr(completed, key)
            for key in (
                "content",
                "provider",
                "model_name",
                "tool_calls",
                "raw_message",
                "finish_reason",
                "input_tokens",
                "output_tokens",
                "fallback_used",
                "fallback_source",
            )
        )
    )
    need(
        not paid.fallback_used
        and not paid.tool_calls
        and paid.model_name == run.model_name
        and paid.provider == run.provider
        and paid.finish_reason == run.finish_reason
        and paid.finish_reason in {"stop", "end_turn", "completed"}
        and paid.input_tokens == run.input_tokens
        and paid.output_tokens == run.output_tokens
    )
    origin = {
        "schema": "paid-call-origin.v1",
        "status": "recorded",
        "project_id": None,
        "workflow_run_id": str(run.workflow_run_id),
        "step_run_id": None,
        "logical_role": run.logical_role,
        "prompt_template": run.prompt_template,
        "prompt_version": run.prompt_version,
        "prompt_hash": digest,
    }
    for metadata in (run.metadata_json, paid.metadata, completed.metadata):
        receipt = (metadata or {}).get("effective_input_receipt") or {}
        need(
            receipt.get("schema") == "effective-input.v1"
            and receipt.get("hash") == digest
            and receipt.get("model") == run.model_name
        )
    need(
        llm._cached_paid_call_origin(paid.metadata) == origin
        and llm._cached_paid_call_origin(completed.metadata) == origin
    )
    return paid, root.key


async def _prove_consumed_logline_control(
    session, *, project_id, operation, actual_attempts, original_runs, transport_results
):
    """Prove an exact zero-send producer control and its consumed parent cap."""
    from sqlalchemy import inspect

    from bestseller.infra.db.models import (
        ExecutionAttemptModel as Attempt,
    )
    from bestseller.infra.db.models import (
        ExecutionBudgetModel as Budget,
    )
    from bestseller.infra.db.models import (
        ExecutionOperationModel as Operation,
    )
    from bestseller.infra.db.models import (
        LlmRunModel as Run,
    )
    from bestseller.infra.db.models import (
        ProjectModel as Project,
    )
    from bestseller.infra.db.models import (
        WorkflowRunModel as Workflow,
    )
    from bestseller.services import conception_logline_recovery as native
    from bestseller.services.budget import execution_operation_id
    from bestseller.services.commercial_request_purpose import prove_known_noncommercial_request
    from bestseller.services.conception_checkpoints import validate_conception_checkpoint
    from bestseller.services.prompt_source_policy import content_hash
    from bestseller.services.retained_planning_generation import _Reader
    from bestseller.services.single_dispatch_authorization import authorization_id

    def need(value):
        if not value:
            raise ValueError("native_logline_control_unproven")

    def row(value, model):
        return json.loads(
            json.dumps(
                {field.key: getattr(value, field.key) for field in inspect(model).column_attrs},
                default=str,
            )
        )

    try:
        with session.no_autoflush:
            reader = _Reader(session)
            project = await reader.get(Project, UUID(str(project_id)))
            control = await reader.get(Operation, operation.key)
            need(
                project is not None
                and control is not None
                and not actual_attempts
                and not original_runs
                and not transport_results
                and _digest(row(control, Operation)) == _digest(row(operation, Operation))
            )
            scope = (project.metadata_json or {}).get("execution_scope_id")
            plan = deepcopy(control.result_json)
            need(
                isinstance(plan, dict)
                and control.scope_id == scope
                and control.status == "conception_logline_replacement"
                and plan.get("schema") == native.SCHEMA
                and plan.get("scope_id") == scope
                and scope == "conception:" + str(UUID(plan["task_id"]))
                and plan.get("slug") == project.slug
                and control.owner == plan.get("operator_actor")
                and isinstance(control.owner, str)
                and bool(control.owner)
                and type(plan.get("physical_attempt_cap")) is int
                and plan["physical_attempt_cap"] == 1
                and plan.get("remote_outcome") == "unknown_quarantined"
                and all(
                    plan.get(k) is False
                    for k in (
                        "credit_released",
                        "old_operation_replay_allowed",
                        "adoption_authorized",
                    )
                )
                and type(plan.get("provider_calls")) is int
                and plan["provider_calls"] == 0
            )
            unsigned = deepcopy(plan)
            plan_sha = unsigned.pop("plan_sha256")
            need(
                content_hash(unsigned) == plan_sha
                and control.input_hash == content_hash(plan)
                and control.key == native._key(native.SCHEMA, scope, plan["original_operation_key"])
            )
            need(not await reader.rows(Attempt, Attempt.operation_key == control.key))
            need(
                not await reader.rows(
                    Run,
                    Run.metadata_json["execution_receipt"]["operation_key"].as_string()
                    == control.key,
                )
            )
            need(
                not await reader.rows(
                    Operation,
                    Operation.status == "transport_result",
                    Operation.result_json["operation_key"].as_string() == control.key,
                )
            )
            source = await reader.get(Workflow, UUID(plan["source_workflow_id"]))
            need(
                source is not None
                and source.project_id is None
                and source.workflow_type == "conception_initial"
                and source.status == "failed"
                and source.error_message == "execution_result_unknown"
                and (source.metadata_json or {}).get("execution_scope_id") == scope
            )
            checkpoint = (source.metadata_json or {}).get("conception_checkpoint")
            validate_conception_checkpoint(
                checkpoint,
                input_hash=(source.metadata_json or {}).get("conception_checkpoint_input_hash"),
            )
            need(
                checkpoint["state_sha256"] == plan["checkpoint_state_sha256"]
                and checkpoint["input_hash"] == plan["stable_input_hash"]
                and (source.metadata_json or {}).get("creation_intent_hash")
                == plan["creation_intent_hash"]
            )
            old = await reader.get(Operation, plan["original_operation_key"])
            need(
                old is not None
                and old.scope_id == scope
                and old.status == "stopped"
                and old.result_json is None
                and old.input_hash == plan["input_hash"]
            )
            old_attempts = await reader.rows(Attempt, Attempt.operation_key == old.key)
            need(
                len(old_attempts) == 1
                and old_attempts[0].id == plan["original_attempt_id"]
                and old_attempts[0].scope_id == scope
                and old_attempts[0].status == "reconciled_charged"
                and old_attempts[0].actual_tokens is None
                and old_attempts[0].reserved_tokens > 0
            )
            need(
                not await reader.rows(
                    Run,
                    Run.metadata_json["execution_receipt"]["operation_key"].as_string() == old.key,
                )
            )
            need(
                not await reader.rows(
                    Operation,
                    Operation.status == "transport_result",
                    Operation.result_json["operation_key"].as_string() == old.key,
                )
            )
            quarantine = plan["quarantine"]
            reconciliation = await reader.get(
                Operation, native._key("reconciliation.v1", scope, quarantine["reconciliation_id"])
            )
            record = reconciliation.result_json if reconciliation is not None else {}
            need(
                reconciliation is not None
                and reconciliation.scope_id == scope
                and reconciliation.status == "reconciliation_receipt"
                and record.get("receipt") == quarantine
                and content_hash(record) == plan["quarantine_record_sha256"]
                and record.get("local_dispatcher_stopped") is True
                and record.get("remote_operation_closed") is False
                and quarantine.get("decision") == "quarantine_charged"
                and quarantine.get("remote_outcome") == "unknown_quarantined"
                and quarantine.get("operation_replay_allowed") is False
                and quarantine.get("credit_released") is False
                and quarantine.get("attempt_id") == old_attempts[0].id
            )
            for kind, status, key in (
                ("transport-failure.v1", "transport_failure_receipt", "failure_sha256"),
                ("provider-return.v1", "unusable_provider_return", "partial_sha256"),
            ):
                proof = await reader.get(Operation, native._key(kind, scope, old_attempts[0].id))
                need(
                    proof is not None
                    and proof.scope_id == scope
                    and proof.status == status
                    and proof.input_hash == old.input_hash
                    and content_hash(proof.result_json) == plan[key]
                )
            operation_id = execution_operation_id(
                native.SCHEMA, subject=old.key, revision=plan["input_hash"]
            )
            replacement_key = hashlib.sha256((scope + "\n" + operation_id).encode()).hexdigest()
            need(
                plan["operation_id"] == operation_id
                and plan["replacement_operation_key"] == replacement_key
                and plan["prompt_version"] == "v3:replacement:" + old.key[:16]
            )
            budget = await reader.get(Budget, scope)
            need(budget is not None)
            grant_id = authorization_id(plan["authorization_ref"] + ":" + old.key, source.id)
            grant = ((budget.metadata_json or {}).get("single_dispatch_grants") or {}).get(grant_id)
            need(
                isinstance(grant, dict)
                and grant.get("schema") == "single-dispatch-authorization.v1"
                and grant.get("status") == "spent"
                and grant.get("physical_attempt_cap") == 1
            )
            replacement = await reader.get(Operation, replacement_key)
            attempts = await reader.rows(Attempt, Attempt.operation_key == replacement_key)
            candidates = await reader.rows(Run, Run.prompt_hash == plan["input_hash"])
            runs = [
                r
                for r in candidates
                if (r.metadata_json or {}).get("execution_receipt", {}).get("operation_key")
                == replacement_key
            ]
            transports = await reader.rows(
                Operation,
                Operation.scope_id == scope,
                Operation.status == "transport_result",
                Operation.result_json["operation_key"].as_string() == replacement_key,
            )
            need(
                replacement is not None
                and replacement.scope_id == scope
                and replacement.status == "completed"
                and replacement.input_hash == plan["input_hash"]
                and len(attempts) == len(runs) == len(transports) == 1
                and grant.get("used_attempt_id") == attempts[0].id
            )
            run = runs[0]
            need(
                run.project_id is None
                and run.step_run_id is None
                and run.logical_role == "critic"
                and run.prompt_template == "logline_gate"
                and run.prompt_version == plan["prompt_version"]
                and run.model_name == attempts[0].model_name == native.MODEL
            )
            binding = {
                "scope_id": scope,
                "operation_key": replacement_key,
                "input_hash": plan["input_hash"],
                "model": native.MODEL,
                "endpoint": native.ENDPOINT,
                "workflow_id": str(run.workflow_run_id),
                "user_message_id": plan["authorization_ref"] + ":" + old.key,
                "prior_workflow_id": str(source.id),
                "prior_journal_sha256": plan_sha,
                "template": "logline_gate",
                "version_prefix": plan["prompt_version"],
                "authority_evidence": plan,
            }
            need(grant.get("binding") == binding)
            for parent, actual, linked, returned, failures in (
                (
                    old,
                    old_attempts,
                    [],
                    [],
                    [
                        await reader.get(
                            Operation,
                            native._key("transport-failure.v1", scope, old_attempts[0].id),
                        )
                    ],
                ),
                (replacement, attempts, runs, transports, []),
            ):
                need(
                    prove_known_noncommercial_request(
                        operation=row(parent, Operation),
                        actual_attempts=[row(a, Attempt) for a in actual],
                        original_runs=[row(r, Run) for r in linked],
                        transport_results=[row(o, Operation) for o in returned],
                        failure_receipts=[row(o, Operation) for o in failures],
                    )
                )
            return {
                "schema": "native-conception-logline-control-purpose.v1",
                "control_key": control.key,
                "scope_project_id": str(project.id),
                "request_project_id": None,
                "execution_scope_id": scope,
                "plan_sha256": plan_sha,
                "original_operation_key": old.key,
                "replacement_operation_key": replacement_key,
                "provider_calls": 0,
                "database_writes": 0,
                "new_credit_allowed": False,
                "dispatch_authorized": False,
                "grade_granted": False,
                "budget_reset_allowed": False,
                "history_rewritten": False,
                "remote_operation_closed": False,
                "old_operation_replay_allowed": False,
            }
    except (ValueError, TypeError, KeyError, AttributeError, OSError, RecursionError):
        return None


async def prove_native_conception_request(
    session,
    settings,
    *,
    project_id,
    operation,
    actual_attempts,
    original_runs,
    transport_results,
):
    """Prove eight exact pre-project purposes; never assign their NULL owner.

    Read complete native rows and physical input/return/settlement again. A
    missing proof returns None so the ordinary opaque-operation fence remains.
    This read cannot release credit, grant a review, mutate history or send.
    """
    if settings is None:
        return None
    if operation.status == "conception_logline_replacement":
        return await _prove_consumed_logline_control(session, project_id=project_id,
            operation=operation, actual_attempts=actual_attempts, original_runs=original_runs,
            transport_results=transport_results)
    if not original_runs or operation.status != "completed":
        return None
    if not all(
        r.project_id is None
        and (r.logical_role, r.prompt_template, r.prompt_version) in _NATIVE_CONCEPTION_ROUTES
        for r in original_runs
    ):
        return None
    from types import SimpleNamespace

    from sqlalchemy import inspect

    from bestseller.infra.db.models import (
        ExecutionAttemptModel,
        ExecutionBudgetModel,
        ExecutionOperationModel,
        LlmRunModel,
        ProjectModel,
        WorkflowRunModel,
    )
    from bestseller.services import llm
    from bestseller.services import retained_planning_generation as physical
    from bestseller.services import retained_review_input_proof as proof
    from bestseller.services.retained_planning_generation import _Reader

    def need(value):
        if not value:
            raise ValueError("native_conception_purpose_unproven")

    def snapshot(row, model):
        return {field.key: getattr(row, field.key) for field in inspect(model).column_attrs}

    def exact_rows(supplied, fresh, model):
        return sorted(_digest(snapshot(row, model)) for row in supplied) == sorted(
            _digest(snapshot(row, model)) for row in fresh
        )

    try:
        with session.no_autoflush:
            reader = _Reader(session)
            project = await reader.get(ProjectModel, UUID(str(project_id)))
            root = await reader.get(ExecutionOperationModel, operation.key)
            need(project is not None and root is not None)
            scope = (project.metadata_json or {}).get("execution_scope_id")
            need(
                isinstance(scope, str)
                and scope.startswith("conception:")
                and root.scope_id == scope
                and root.status == "completed"
                and _digest(snapshot(root, ExecutionOperationModel))
                == _digest(snapshot(operation, ExecutionOperationModel))
            )
            need(await reader.get(ExecutionBudgetModel, scope) is not None)
            attempts = await reader.rows(
                ExecutionAttemptModel, ExecutionAttemptModel.operation_key == root.key
            )
            candidates = await reader.rows(LlmRunModel, LlmRunModel.prompt_hash == root.input_hash)
            runs = [
                r
                for r in candidates
                if (
                    (r.metadata_json or {}).get("execution_receipt", {}).get("operation_key")
                    == root.key
                    and (r.metadata_json or {}).get("execution_receipt", {}).get("scope_id")
                    == scope
                )
            ]
            transports = await reader.rows(
                ExecutionOperationModel,
                ExecutionOperationModel.scope_id == scope,
                ExecutionOperationModel.status == "transport_result",
                ExecutionOperationModel.result_json["operation_key"].as_string() == root.key,
            )
            need(
                len(attempts) == len(runs) == len(transports) == 1
                and exact_rows(actual_attempts, attempts, ExecutionAttemptModel)
                and exact_rows(original_runs, runs, LlmRunModel)
                and exact_rows(transport_results, transports, ExecutionOperationModel)
            )
            run, attempt = runs[0], attempts[0]
            need(
                run.project_id is None
                and run.step_run_id is None
                and (run.logical_role, run.prompt_template, run.prompt_version)
                in _NATIVE_CONCEPTION_ROUTES
                and run.prompt_hash == root.input_hash
                and run.workflow_run_id is not None
                and attempt.scope_id == scope
                and attempt.status == "completed"
                and attempt.input_hash == root.input_hash
                and attempt.actual_tokens == run.input_tokens + run.output_tokens
            )
            owner = await reader.get(WorkflowRunModel, run.workflow_run_id)
            need(
                owner is not None
                and owner.project_id is None
                and owner.workflow_type == "conception_initial"
                and owner.scope_type == "creation"
                and owner.scope_id is None
                and (owner.metadata_json or {}).get("execution_scope_id") == scope
            )
            request, response, request_sha, response_sha, effective = _native_conception_payloads(
                settings, run
            )
            need(
                request.project_id is None
                and request.step_run_id is None
                and request.workflow_run_id == run.workflow_run_id
                and (request.logical_role, request.prompt_template, request.prompt_version)
                == (run.logical_role, run.prompt_template, run.prompt_version)
                and not request.tools
                and request.tool_choice is None
            )
            catalog, _ = proof._fresh_catalog()
            # Before project creation the original request used the global role.
            role = llm._apply_conception_phase_settings(
                request,
                proof._fresh_role(settings, SimpleNamespace(metadata_json={}), request, catalog),
            )
            need(
                effective.get("configured_model") == effective.get("model") == run.model_name
                and effective.get("model") == role.model
                and effective.get("provider") == run.provider
                and type(effective.get("stream")) is bool
                and type(effective.get("max_tokens")) is int
                and effective["max_tokens"] > 0
                and type(effective.get("temperature")) in (int, float)
                and (
                    effective.get("thinking_type") is None
                    or isinstance(effective["thinking_type"], str)
                )
                and (
                    effective.get("reasoning_effort") is None
                    or isinstance(effective["reasoning_effort"], str)
                )
            )
            # Sending-time stream/thinking overrides are retained physically.
            # Restore those exact values, then authenticate the complete input
            # including the still-matching concrete model/endpoint hash.
            role = role.model_copy(
                update={
                    key: effective[key]
                    for key in (
                        "temperature",
                        "max_tokens",
                        "stream",
                        "thinking_type",
                        "reasoning_effort",
                    )
                }
            )
            digest = llm._effective_input_hash(request, role)
            need(digest == root.input_hash and role.model == run.model_name)
            paid, key = _native_conception_paid_return(
                root, attempt, transports[0], run, scope=scope, digest=digest
            )
            physical._response(response, paid)
            need(
                key == root.key
                and not paid.tool_calls
                and not paid.fallback_used
                and paid.finish_reason in {"stop", "end_turn", "completed"}
                and paid.input_tokens == run.input_tokens
                and paid.output_tokens == run.output_tokens
            )
            origin = {
                "schema": "paid-call-origin.v1",
                "status": "recorded",
                "project_id": None,
                "workflow_run_id": str(run.workflow_run_id),
                "step_run_id": None,
                "logical_role": run.logical_role,
                "prompt_template": run.prompt_template,
                "prompt_version": run.prompt_version,
                "prompt_hash": digest,
            }
            need(
                llm._cached_paid_call_origin((root.result_json or {}).get("metadata") or {})
                == origin
                and llm._cached_paid_call_origin(paid.metadata) == origin
            )
            return {
                "schema": "native-conception-request-purpose.v1",
                "scope_project_id": str(project.id),
                "request_project_id": None,
                "workflow_project_id": None,
                "execution_scope_id": scope,
                "operation_key": root.key,
                "llm_run_id": str(run.id),
                "workflow_run_id": str(owner.id),
                "logical_role": run.logical_role,
                "prompt_template": run.prompt_template,
                "prompt_version": run.prompt_version,
                "effective_input_sha256": digest,
                "request_file_sha256": request_sha,
                "response_file_sha256": response_sha,
                "historical_effective_parameters_sha256": _digest(effective),
                "root_sha256": _digest(snapshot(root, ExecutionOperationModel)),
                "attempt_sha256": _digest(snapshot(attempt, ExecutionAttemptModel)),
                "provider_calls": 0,
                "database_writes": 0,
                "new_credit_allowed": False,
                "dispatch_authorized": False,
                "grade_granted": False,
                "budget_reset_allowed": False,
                "history_rewritten": False,
            }
    except (ValueError, TypeError, KeyError, AttributeError, OSError, RecursionError):
        return None


def bind_commercial_slot_result(
    result: LLMQualityJudgeResult,
    *,
    raw_report: str,
    validation_errors: tuple[str, ...],
    source_receipt: Mapping[str, Any],
    sample_slot: Any,
    attempt: int,
    adapter_receipt: Mapping[str, Any] | None = None,
    evaluation_contract: Mapping[str, Any] | None = None,
) -> LLMQualityJudgeResult:
    receipt = {
        "schema_version": SLOT_RECEIPT_SCHEMA,
        "sample_slot": sample_slot,
        "attempt": attempt,
        "source_binding": {key: source_receipt[key] for key in _BINDING_KEYS},
        "exact_source_audit": {key: source_receipt[key] for key in _EXACT_AUDIT_KEYS},
        "validation_errors": list(validation_errors),
        "raw_report": raw_report,
        "raw_report_sha256": hashlib.sha256(raw_report.encode()).hexdigest(),
        "original_overall_score": result.overall_score,
        "original_dimension_scores": dict(result.dimension_scores),
        "adapter_receipt": dict(adapter_receipt or {}),
        "evaluation_contract": dict(evaluation_contract or {}),
    }
    return result.model_copy(update={"raw_excerpt": json.dumps(receipt, ensure_ascii=False)})


async def load_commercial_retry_context(
    session: Any,
    *,
    project_id: Any,
    chapter_id: Any,
    draft_id: Any,
    content_md: str,
    retry_context: Mapping[str, Any] | None,
    sources: CommercialSources | None = None,
) -> dict[str, Any] | None:
    """Read the previous report's existing sample cohort, with strict ownership."""
    if retry_context is not None and not isinstance(retry_context, Mapping):
        raise ValueError("commercial_recovery_context_invalid")
    if not retry_context:
        return None
    if type(retry_context.get("attempt")) is not int or retry_context.get("attempt") != 2:
        raise ValueError("commercial_recovery_requires_existing_second_round")
    from bestseller.infra.db.models import LlmRunModel, ReviewReportModel

    prior_id = retry_context.get("prior_report_id")
    if prior_id is None or prior_id == "":
        raise ValueError("commercial_recovery_prior_report_id_missing")
    try:
        if not isinstance(prior_id, (str, UUID)):
            raise ValueError
        prior_id = UUID(str(prior_id))
        if prior_id.int == 0:
            raise ValueError
    except (ValueError, TypeError, AttributeError):
        raise ValueError("commercial_recovery_prior_report_id_invalid") from None
    prior = await session.get(ReviewReportModel, prior_id)
    if (
        prior is None
        or prior.project_id != project_id
        or prior.target_id != chapter_id
        or prior.target_type != "chapter"
    ):
        raise ValueError("commercial_recovery_prior_report_scope_mismatch")
    payload = prior.structured_output or {}
    fingerprint = (payload.get("reviewed_body_fingerprint") or {}).get("digest")
    expected = hashlib.sha256(
        content_md.replace("\r\n", "\n").replace("\r", "\n").encode()
    ).hexdigest()
    if payload.get("draft_id") != str(draft_id) or fingerprint != expected:
        raise ValueError("commercial_recovery_prior_body_mismatch")
    summary = payload.get("evidence_summary") or {}
    commercial = summary.get("llm_commercial_judge") or {}
    from bestseller.services.commercial_slot_quarantine import (
        SCHEMA as QUARANTINE_SCHEMA,
        load_verified_quarantined_slot_proofs,
        requires_verified_quarantine_slots,
    )

    projection = summary.get("commercial_action_projection")
    if projection is not None:
        original = summary.get("llm_commercial_judge_original")
        if not isinstance(original, Mapping):
            raise ValueError("commercial_recovery_quarantine_original_required")
        original_result = LLMQualityJudgeResult.model_validate(original)
        # Reviews store `pass` aliases; the projector hashes the typed `passed`
        # representation. Authenticate that same representation before choosing
        # the original, including when the derived unavailable wrapper is empty.
        normalized_original = original_result.model_dump(mode="json")
        if (
            not isinstance(projection, Mapping)
            or projection.get("schema") != "commercial-action-projection.v1"
            or projection.get("original_aggregate_sha256") != _digest(normalized_original)
            or any(projection.get(key) is not False for key in (
                "scores_modified", "raw_cohort_modified", "grants_slots", "authorizes_replay",
            ))
        ):
            raise ValueError("commercial_recovery_projection_original_changed")
        if (
            (not commercial.get("raw_excerpt") or requires_verified_quarantine_slots(commercial))
            and not requires_verified_quarantine_slots(original_result)
        ):
            raise ValueError("commercial_recovery_quarantine_original_required")
        commercial = normalized_original
    verified_quarantines = {}
    if requires_verified_quarantine_slots(commercial):
        if not isinstance(sources, CommercialSources):
            raise ValueError("commercial_recovery_quarantine_current_sources_required")
        verified_quarantines = await load_verified_quarantined_slot_proofs(
            session, project_id=project_id, chapter_id=chapter_id, content_md=content_md,
            result=LLMQualityJudgeResult.model_validate(commercial), sources=sources,
        )
    if _is_unpaid_commercial_placeholder(commercial):
        # A budget refusal is typed input evidence, not a paid slot receipt.
        # Bind its body too; the later preparation still proves source/contract
        # and excludes paid/journal/ledger orphans without resetting a cursor.
        if commercial.get("raw_excerpt"):
            unpaid = json.loads(commercial["raw_excerpt"])
            children = (unpaid.get("samples") or []) if unpaid.get("schema_version") == "chapter-quality-aggregation.v1" else []
            receipts = [json.loads(item["report"]["raw_excerpt"]) for item in children
                        if item["report"].get("raw_excerpt")]
            if not children:
                receipts = [unpaid]
            if any((item.get("source_binding", {}).get("body_sha256")
                    if item.get("schema") == "commercial-review-transport.v1"
                    else item.get("body_sha256")) != hashlib.sha256(content_md.encode()).hexdigest()
                   for item in receipts):
                raise ValueError("commercial_recovery_prior_body_mismatch")
        return None
    try:
        cohort = json.loads(commercial.get("raw_excerpt") or "")
    except (TypeError, ValueError) as exc:
        raise ValueError("commercial_recovery_sample_receipt_missing") from exc
    if not isinstance(cohort, Mapping):
        raise ValueError("commercial_recovery_sample_receipt_invalid")
    if cohort.get("schema_version") == SLOT_RECEIPT_SCHEMA or cohort.get("schema") == QUARANTINE_SCHEMA:
        samples = [{"sample_slot": cohort.get("sample_slot"), "report": commercial}]
    elif cohort.get("schema_version") == "chapter-quality-aggregation.v1":
        samples = cohort.get("samples") or []
    else:
        raise ValueError("commercial_recovery_sample_receipt_unknown")
    if not isinstance(samples, list):
        raise ValueError("commercial_recovery_sample_cohort_invalid")
    slots = {}
    for sample in samples:
        if not isinstance(sample, Mapping):
            raise ValueError("commercial_recovery_sample_identity_invalid")
        slot, report = sample.get("sample_slot"), sample.get("report")
        if not isinstance(slot, str) or slot in slots or not isinstance(report, Mapping):
            raise ValueError("commercial_recovery_sample_identity_invalid")
        raw = report.get("raw_excerpt") or ""
        try:
            envelope = json.loads(raw)
        except (TypeError, ValueError):
            envelope = {}
        if isinstance(envelope, Mapping) and envelope.get("schema") == QUARANTINE_SCHEMA:
            proof = verified_quarantines.get(slot)
            if proof is None or proof["original_report_sha256"] != _digest(report):
                raise ValueError("commercial_recovery_quarantine_proof_required")
            # An authenticated abstention stays visible in the existing cohort,
            # but never becomes wire-repair input or a new sampling allowance.
            slots[slot] = {
                "state": "quarantined", "report": dict(report), "raw_report": "",
                "source_binding": deepcopy(proof["source_binding"]),
                "evaluation_contract": deepcopy(proof["evaluation_contract"]),
                "spent_attempt": envelope["attempt"],
                "quarantine_proof_sha256": envelope["proof_sha256"],
                "exact_source_audit": {}, "prior_validation_errors": [],
            }
            continue
        if isinstance(envelope, Mapping) and envelope.get("schema_version") == SLOT_RECEIPT_SCHEMA:
            if envelope.get("sample_slot") != slot or envelope.get("attempt") not in (1, 2):
                raise ValueError("commercial_recovery_sample_round_mismatch")
            binding = envelope.get("source_binding") or {}
            raw = envelope.get("raw_report") or ""
            if not isinstance(raw, str) or (
                hashlib.sha256(raw.encode()).hexdigest() != envelope.get("raw_report_sha256")
            ):
                raise ValueError("commercial_recovery_raw_report_hash_mismatch")
            prior_errors = envelope.get("validation_errors") or []
            exact_audit = envelope.get("exact_source_audit") or {}
        else:
            # Legacy v7 invalid reports retain full raw content, while the paid
            # run holds the original request source receipt. Read, never mutate.
            run_id = report.get("llm_run_id")
            if run_id is None or run_id == "":
                raise ValueError("commercial_recovery_paid_run_id_missing")
            try:
                if not isinstance(run_id, (str, UUID)):
                    raise ValueError
                run_id = UUID(str(run_id))
                if run_id.int == 0:
                    raise ValueError
            except (ValueError, TypeError, AttributeError):
                raise ValueError("commercial_recovery_paid_run_id_invalid") from None
            run = await session.get(LlmRunModel, run_id)
            if run is None or run.project_id != project_id:
                raise ValueError("commercial_recovery_legacy_source_receipt_missing")
            binding = (run.metadata_json or {}).get("commercial_source_input_receipt") or {}
            exact_audit = {key: binding.get(key) for key in _EXACT_AUDIT_KEYS}
            prior_errors = [
                issue.get("evidence")
                for issue in report.get("blocking_issues", [])
                if issue.get("code") == "CHAPTER_JUDGE_UNAVAILABLE"
            ]
        if not isinstance(raw, str) or not raw.strip():
            raise ValueError("commercial_recovery_raw_report_missing")
        slots[slot] = {
            "report": dict(report),
            "raw_report": raw,
            "source_binding": binding,
            "exact_source_audit": exact_audit,
            "prior_validation_errors": prior_errors,
            "evaluation_contract": (envelope.get("evaluation_contract") or {})
            if isinstance(envelope, Mapping)
            else {},
            "spent_attempt": envelope.get("attempt", 1),
        }
    if not slots:
        raise ValueError("commercial_recovery_sample_cohort_empty")
    return {"attempt": 2, "prior_report_id": str(prior.id), "slots": slots}


def prepare_commercial_slot_retry(
    context: Mapping[str, Any],
    *,
    sample_slot: Any,
    sources: CommercialSources,
    evaluation_contract: Mapping[str, Any] | None = None,
) -> tuple[LLMQualityJudgeResult | None, str, dict[str, Any]]:
    """Reuse a verified slot or build feedback for exactly its invalid report."""
    if context.get("attempt") != 2:
        raise ValueError("commercial_recovery_round_limit")
    entry = (context.get("slots") or {}).get(sample_slot)
    if not isinstance(entry, Mapping):
        raise ValueError("commercial_recovery_matching_slot_missing")
    if evaluation_contract is not None and entry.get("evaluation_contract") != evaluation_contract:
        raise ValueError("commercial_recovery_evaluation_contract_changed")
    binding = entry.get("source_binding") or {}
    if not isinstance(binding, Mapping):
        raise ValueError("commercial_recovery_source_binding_changed")
    legacy = "semantic_source_sha256" not in binding
    keys = _EXACT_AUDIT_KEYS if legacy else _BINDING_KEYS
    if any(not binding.get(key) or binding[key] != sources.receipt[key] for key in keys):
        raise ValueError("commercial_recovery_source_binding_changed")
    if legacy and binding.get("schema_version") != sources.receipt["schema_version"]:
        raise ValueError("commercial_recovery_legacy_protocol_changed")
    raw = entry.get("raw_report")
    if not isinstance(raw, str) or not raw.strip():
        raise ValueError("commercial_recovery_raw_report_missing")
    parsed, adapter_receipt, errors = parse_commercial_wire(raw, sources)
    report = LLMQualityJudgeResult.model_validate(entry["report"])
    if entry.get("spent_attempt") == 2 and report.infrastructure_failure:
        return report, "", {"status": "reused_exhausted_slot", "sample_slot": sample_slot}
    if not errors and not report.infrastructure_failure and not legacy:
        if evaluation_contract is not None:
            from bestseller.domain.llm_quality_judge import quality_judge_result_from_mapping

            expected = quality_judge_result_from_mapping(
                parsed,
                scope="chapter",
                min_overall=evaluation_contract["min_overall"],
                min_dimensions=evaluation_contract["min_dimensions"],
                llm_run_id=report.llm_run_id,
            )
            excluded = {"raw_excerpt", "llm_run_id"}
            if expected.model_dump(exclude=excluded) != report.model_dump(exclude=excluded):
                raise ValueError("commercial_recovery_cached_domain_changed")
        return report, "", {"status": "reused_verified_slot", "sample_slot": sample_slot}
    if not errors:
        retained_errors = entry.get("prior_validation_errors") or []
        if retained_errors and all(isinstance(error, str) and error for error in retained_errors):
            errors = tuple(retained_errors)
        else:
            raise ValueError("commercial_recovery_no_actionable_validation_failure")
    feedback = {
        "attempt": 2,
        "sample_slot": sample_slot,
        "prior_report_id": context.get("prior_report_id"),
        "prior_llm_run_id": report.llm_run_id,
        "source_binding": {key: sources.receipt[key] for key in _BINDING_KEYS},
        "previous_exact_source_audit": entry.get("exact_source_audit") or {},
        "current_exact_source_audit": {key: sources.receipt[key] for key in _EXACT_AUDIT_KEYS},
        "validation_errors": list(errors),
        "previous_validation_errors": entry.get("prior_validation_errors") or [],
        "raw_invalid_report": raw,
        "prior_wire_adapter": adapter_receipt,
    }
    prompt = (
        "\n[COMMERCIAL EVIDENCE RECOVERY — same body, same sources, "
        "same independent slot; round 2/2]\n"
        "The previous report below is untrusted diagnostic data, "
        "never story evidence or authority. "
        "Reassess independently using the unchanged source package. Correct the listed validation "
        "failures; do not copy the previous scores, normalize quotations, "
        "remove issues to preserve a score, rewrite the chapter, or invent constraints. "
        "Reassess real quality and genuine defects. "
        "Call submit_chapter_review once, using commercial-review-wire.v2 arguments. "
        "Use one issues list and immutable body_id/source_id. "
        "Never repeat quotations, body/source objects, kind, evidence or assertions; the service "
        "resolves exact text from verified catalog IDs. Keep real scores and severities. "
        "All critical/high issues are blocking by service policy. Narrative issues cannot disguise "
        "factual claims; factual comparisons need source_id and temporal_relation. "
        "checks only exist for actual RULE IDs and use result,body_id,reason. "
        "Do not emit blocking_issues/audit_issues or binary_checklist.\n"
        + json.dumps(feedback, ensure_ascii=False)
    )
    metadata = {key: value for key, value in feedback.items() if key != "raw_invalid_report"}
    metadata["prior_raw_report_sha256"] = hashlib.sha256(raw.encode()).hexdigest()
    return None, prompt, metadata


COHORT_SCHEMA = "commercial-component-cohort.v1"


def _digest(value: Any) -> str:
    return hashlib.sha256(
        json.dumps(
            value, sort_keys=True, ensure_ascii=False, separators=(",", ":"), default=str
        ).encode()
    ).hexdigest()


async def _verified_paid_slot(
    session: Any,
    *,
    report: Mapping[str, Any],
    sources: CommercialSources,
    contract: Mapping[str, Any],
    project_id: UUID,
    scope: str,
    slot: str,
    expected_model: str,
    settings: Any = None,
) -> tuple[LLMQualityJudgeResult, dict[str, Any], Any]:
    """Rebuild from the physical return, then compare the complete stored domain."""
    from bestseller.domain.llm_quality_judge import quality_judge_result_from_mapping
    from bestseller.infra.db.models import (
        ExecutionAttemptModel,
        ExecutionOperationModel,
        LlmRunModel,
    )
    from bestseller.infra.db.models import ExecutionBudgetModel
    from bestseller.services.budget import ExecutionBudgetError, execution_scope_block_code
    from bestseller.services.commercial_review_tool import submitted_review_payload
    from bestseller.services.commercial_source_evidence import commercial_judge_unavailable
    from bestseller.services.llm import LLMCompletionResult

    result = LLMQualityJudgeResult.model_validate(report)
    budget = await session.get(ExecutionBudgetModel, scope)
    blocked = (
        execution_scope_block_code(budget) if budget is not None else "execution_scope_missing"
    )
    if blocked and blocked not in {"execution_deadline_exhausted", "execution_budget_exhausted"}:
        raise ExecutionBudgetError(blocked, scope)
    envelope = json.loads(result.raw_excerpt)
    if (
        envelope.get("schema_version") != SLOT_RECEIPT_SCHEMA
        or envelope.get("sample_slot") != slot
        or type(envelope.get("attempt")) is not int
        or envelope["attempt"] not in (1, 2)
        or envelope.get("evaluation_contract") != contract
        or envelope.get("source_binding") != {k: sources.receipt[k] for k in _BINDING_KEYS}
    ):
        raise ValueError("commercial_cohort_slot_binding_changed")
    run = await session.get(LlmRunModel, UUID(str(result.llm_run_id)))
    if (
        run is None
        or run.project_id != project_id
        or run.prompt_template != "chapter_commercial_quality_judge"
        or run.prompt_version != sources.receipt["prompt_version"]
        or run.model_name != expected_model
        or run.provider in {"mock", "fallback", "test"}
    ):
        raise ValueError("commercial_cohort_paid_run_mismatch")
    metadata = run.metadata_json or {}
    paid_source = metadata.get("commercial_source_input_receipt") or {}
    if any(paid_source.get(k) != sources.receipt[k] for k in _BINDING_KEYS):
        raise ValueError("commercial_cohort_paid_source_mismatch")
    if any(
        paid_source.get(k) != (envelope.get("exact_source_audit") or {}).get(k)
        for k in _EXACT_AUDIT_KEYS
    ):
        raise ValueError("commercial_cohort_paid_exact_audit_mismatch")
    if metadata.get("commercial_sample_slot", slot) != slot:
        raise ValueError("commercial_cohort_paid_slot_mismatch")
    source_transport = metadata.get("commercial_source_transport")
    if source_transport is not None:
        if settings is None:
            raise ValueError("commercial_cohort_transport_settings_required")
        from bestseller.services import retained_review_input_proof as retained
        from bestseller.services.llm import _effective_input_hash
        from bestseller.infra.db.models import ProjectModel
        from bestseller.services.commercial_review_transport import verify_commercial_review_transport

        retained_request = retained._retained_request(settings, run)
        source_project = await session.get(ProjectModel, project_id)
        catalog, _ = retained._fresh_catalog()
        role = retained._fresh_role(settings, source_project, retained_request, catalog)
        if (_effective_input_hash(retained_request, role) != run.prompt_hash
                or role.model != expected_model):
            raise ValueError("commercial_cohort_transport_effective_input_mismatch")
        verify_commercial_review_transport(
            retained_request.user_prompt, sources=sources, receipt=source_transport)
        if (hashlib.sha256(retained_request.user_prompt.encode()).hexdigest()
                != paid_source.get("user_prompt_sha256")):
            raise ValueError("commercial_cohort_transport_request_hash_mismatch")
    execution = metadata.get("execution_receipt") or {}
    if execution.get("scope_id") != scope:
        raise ValueError("commercial_cohort_paid_scope_mismatch")
    operation = await session.get(ExecutionOperationModel, execution.get("operation_key"))
    if operation is None or operation.scope_id != scope or operation.status != "completed":
        raise ValueError("commercial_cohort_paid_operation_unavailable")
    attempts = [a for a in execution.get("attempts", []) if a.get("status") == "completed"]
    if len(attempts) != 1:
        raise ValueError("commercial_cohort_paid_attempt_ambiguous")
    attempt = await session.get(ExecutionAttemptModel, attempts[0]["attempt_id"])
    transport_key = hashlib.sha256(
        f"transport-result.v1\n{scope}\n{attempts[0]['attempt_id']}".encode()
    ).hexdigest()
    transport = await session.get(ExecutionOperationModel, transport_key)
    if (
        attempt is None
        or attempt.scope_id != scope
        or attempt.status != "completed"
        or attempt.operation_key != operation.key
        or attempt.model_name != run.model_name
        or attempt.input_hash != run.prompt_hash
        or transport is None
        or transport.scope_id != scope
        or transport.status != "transport_result"
    ):
        raise ValueError("commercial_cohort_physical_proof_missing")
    proof = transport.result_json or {}
    if (
        proof.get("operation_key") != operation.key
        or proof.get("attempt_id") != attempt.id
        or proof.get("input_hash") != run.prompt_hash
    ):
        raise ValueError("commercial_cohort_physical_proof_mismatch")
    paid = LLMCompletionResult.model_validate(proof.get("result"))
    completed = LLMCompletionResult.model_validate(operation.result_json)
    fields = (
        "content",
        "tool_calls",
        "raw_message",
        "provider",
        "model_name",
        "finish_reason",
        "input_tokens",
        "output_tokens",
    )
    if (
        any(getattr(paid, k) != getattr(completed, k) for k in fields)
        or paid.model_name != run.model_name
        or paid.provider != run.provider
        or paid.fallback_used
        or paid.finish_reason != run.finish_reason
    ):
        raise ValueError("commercial_cohort_paid_return_mismatch")
    origin = (paid.metadata or {}).get("paid_call_origin") or {}
    if (
        origin.get("project_id") != str(project_id)
        or origin.get("workflow_run_id") != str(run.workflow_run_id)
        or origin.get("prompt_hash") != run.prompt_hash
        or origin.get("prompt_template") != run.prompt_template
        or origin.get("prompt_version") != run.prompt_version
    ):
        raise ValueError("commercial_cohort_paid_origin_mismatch")
    raw, submission, submission_errors = submitted_review_payload(paid)
    if (
        raw != envelope.get("raw_report")
        or hashlib.sha256(raw.encode()).hexdigest() != envelope.get("raw_report_sha256")
        or submission != (envelope.get("adapter_receipt") or {}).get("submission")
    ):
        raise ValueError("commercial_cohort_raw_return_mismatch")
    parsed, _, errors = parse_commercial_wire(raw, sources)
    errors = (*submission_errors, *errors)
    if paid.finish_reason in {"length", "max_tokens", "max_output_tokens"}:
        errors = ("output: truncated at structured-review reserve",)
        rebuilt = commercial_judge_unavailable(
            diagnostic="commercial judge output truncated at structured-review reserve; judge-only repair",
            raw=paid.content,
            result=LLMQualityJudgeResult(llm_run_id=result.llm_run_id),
        )
    else:
        try:
            rebuilt = quality_judge_result_from_mapping(
                parsed,
                scope="chapter",
                min_overall=contract["min_overall"],
                min_dimensions=contract["min_dimensions"],
                llm_run_id=result.llm_run_id,
            )
        except (ValueError, TypeError):
            errors = ("report: response schema is unverified",)
            rebuilt = commercial_judge_unavailable(
                diagnostic="commercial judge response schema is unverified",
                raw=paid.content,
                result=LLMQualityJudgeResult(llm_run_id=result.llm_run_id),
            )
        else:
            if errors:
                rebuilt = commercial_judge_unavailable(
                    diagnostic="commercial source evidence unverified: " + "; ".join(errors),
                    raw=paid.content,
                    result=rebuilt,
                )
    if (
        list(errors) != envelope.get("validation_errors")
        or rebuilt.model_dump(exclude={"raw_excerpt"}) != result.model_dump(exclude={"raw_excerpt"})
        or envelope.get("original_overall_score") != result.overall_score
        or envelope.get("original_dimension_scores") != result.dimension_scores
    ):
        raise ValueError("commercial_cohort_cached_domain_changed")
    return result, envelope, run


def _is_unpaid_commercial_placeholder(
    value: Any,
    *,
    expected_samples: int | None = None,
) -> bool:
    """Recognize exact framework no-result domains, never grades or paid receipts.

    This is only a shape classifier. A first cohort still requires the separate
    persisted-spend fence; absence of a run ID alone never proves no payment.
    """
    from bestseller.services.commercial_source_evidence import commercial_judge_unavailable

    if not isinstance(value, Mapping):
        return False
    try:
        result = LLMQualityJudgeResult.model_validate(value)
    except (ValueError, TypeError):
        return False
    # Reject unknown fields and coercions, including a hidden paid proof.
    if dict(value) not in (
        result.model_dump(mode="json"),
        result.model_dump(mode="json", by_alias=True),
    ):
        return False
    if (
        (value.get("passed", value.get("pass")) is not False)
        or isinstance(value.get("overall_score"), bool)
        or value.get("has_critical") is not True
        or result.scope != "chapter"
        or result.passed
        or result.overall_score != 0
        or result.dimension_scores
        or result.llm_run_id is not None
        or result.audit_issues
        or len(result.blocking_issues) != 1
        or result.blocking_issues[0].code != "CHAPTER_JUDGE_UNAVAILABLE"
    ):
        return False
    expected = commercial_judge_unavailable(
        diagnostic=result.blocking_issues[0].evidence,
        raw=result.raw_excerpt,
    )
    domain = result.model_dump(mode="json")
    canonical_unavailable = domain == expected.model_dump(mode="json")
    if result.raw_excerpt == "":
        return canonical_unavailable

    def unique_pairs(pairs: list[tuple[str, Any]]) -> dict[str, Any]:
        result = {}
        for key, value in pairs:
            if key in result:
                raise ValueError("duplicate placeholder receipt key")
            result[key] = value
        return result

    try:
        receipt = json.loads(result.raw_excerpt, object_pairs_hook=unique_pairs)
    except (ValueError, TypeError):
        return False
    if isinstance(receipt, dict) and receipt.get("schema") == "commercial-review-transport.v1":
        from bestseller.services.commercial_source_evidence import (
            COMMERCIAL_OUTPUT_TOKEN_CEILING, TOKEN_SAFETY_FACTOR, TOTAL_TOKEN_BUDGET,
        )
        from bestseller.services.commercial_review_transport import MAX_PROMPT_CHARACTERS

        def digest(value: Any) -> bool:
            return isinstance(value, str) and len(value) == 64 and all(
                char in "0123456789abcdef" for char in value)

        common = {"schema", "original_packet_sha256", "original_packet_characters",
                  "catalog_sha256", "source_binding", "original_prompt_sha256", "capacity"}
        encoded = {"encoding", "wire_prompt_sha256", "wire_packet_sha256", "packet_start",
                   "packet_end", "offset_unit", "codec_receipt", "roundtrip_verified"}
        if (not canonical_unavailable
                or result.blocking_issues[0].evidence != "complete commercial source input exceeds admission budget; no paid judge call"
                or set(receipt) not in (common | {"truncated"}, common | encoded)
                or not isinstance(receipt.get("source_binding"), dict)
                or set(receipt["source_binding"]) != set(_BINDING_KEYS)
                or not all(digest(item) for item in receipt["source_binding"].values())
                or not all(digest(receipt[key]) for key in (
                    "original_packet_sha256", "catalog_sha256", "original_prompt_sha256"))
                or type(receipt["original_packet_characters"]) is not int
                or receipt["original_packet_characters"] <= 0):
            return False
        capacity = receipt["capacity"]
        counts = {"estimated_input_tokens", "reserved_input_tokens", "output_reserve_tokens",
                  "total_token_budget", "tool_schema_estimated_tokens", "combined_characters",
                  "max_combined_characters"}
        if (not isinstance(capacity, dict)
                or set(capacity) != counts | {"token_safety_factor", "tool_schema_sha256",
                                              "budget_passed", "truncated"}
                or any(type(capacity[key]) is not int or capacity[key] < 0 for key in counts)
                or capacity["budget_passed"] is not False or capacity["truncated"] is not False
                or type(capacity["token_safety_factor"]) is not float
                or capacity["token_safety_factor"] != TOKEN_SAFETY_FACTOR
                or capacity["total_token_budget"] != TOTAL_TOKEN_BUDGET
                or capacity["max_combined_characters"] != MAX_PROMPT_CHARACTERS
                or not digest(capacity["tool_schema_sha256"])
                or not 0 < capacity["output_reserve_tokens"] <= COMMERCIAL_OUTPUT_TOKEN_CEILING
                or capacity["estimated_input_tokens"] <= 0
                or capacity["tool_schema_estimated_tokens"] > capacity["estimated_input_tokens"]):
            return False
        try:
            if capacity["reserved_input_tokens"] != int(capacity["estimated_input_tokens"] * TOKEN_SAFETY_FACTOR) + 512:
                return False
            json.dumps(receipt, allow_nan=False)
        except (ValueError, TypeError, OverflowError):
            return False
        if (capacity["reserved_input_tokens"] + capacity["output_reserve_tokens"] <= TOTAL_TOKEN_BUDGET
                and capacity["combined_characters"] <= MAX_PROMPT_CHARACTERS):
            return False
        if "truncated" in receipt:
            return receipt["truncated"] is False
        if (receipt["encoding"] not in {"json-pointer", "indexed-json-pointer", "key-dictionary"}
                or receipt["roundtrip_verified"] is not True
                or receipt["offset_unit"] != "unicode_code_points"
                or not all(digest(receipt[key]) for key in ("wire_prompt_sha256", "wire_packet_sha256"))
                or type(receipt["packet_start"]) is not int or type(receipt["packet_end"]) is not int
                or not 0 <= receipt["packet_start"] < receipt["packet_end"] <= capacity["combined_characters"]):
            return False
        codec = receipt["codec_receipt"]
        codec_keys = {"original_sha256", "encoded_sha256", "original_bytes", "encoded_bytes", "shrunk"}
        if receipt["encoding"] == "key-dictionary":
            codec_keys |= {"inner_sha256", "inner_bytes"}
        return (isinstance(codec, dict) and set(codec) == codec_keys
                and codec["shrunk"] is True
                and all(digest(codec[key]) for key in codec_keys if key.endswith("sha256"))
                and all(type(codec[key]) is int and codec[key] > 0
                        for key in codec_keys if key.endswith("bytes")))
    if isinstance(receipt, dict) and receipt.get("schema_version") == "commercial-source-evidence.v3":
        from bestseller.services.commercial_source_evidence import (
            COMMERCIAL_OUTPUT_TOKEN_CEILING, PROMPT_VERSION, TOKEN_SAFETY_FACTOR, TOTAL_TOKEN_BUDGET,
        )

        hashes = {*_BINDING_KEYS, "source_sha256", "assembled_source_sha256", "system_prompt_sha256",
                  "user_prompt_sha256", "tool_schema_sha256"}
        counts = {"assembled_characters", "catalog_entries", "rendered_catalog_characters",
                  "estimated_input_tokens", "tool_schema_estimated_tokens", "reserved_input_tokens",
                  "output_reserve_tokens", "total_token_budget"}
        keys = hashes | counts | {"schema_version", "prompt_version", "source_selection", "previous",
            "source_complete_for_supplied_projection", "structural_aliases", "section_characters",
            "truncated", "token_safety_factor", "budget_passed"}
        if set(receipt) != keys:
            return False
        try:
            expected_reserved = int(receipt["estimated_input_tokens"] * TOKEN_SAFETY_FACTOR) + 512
        except (ValueError, TypeError, OverflowError):
            return False
        if (not canonical_unavailable
                or result.blocking_issues[0].evidence != "complete commercial source input exceeds admission budget; no paid judge call"
                or receipt["prompt_version"] != PROMPT_VERSION
                or receipt["budget_passed"] is not False or receipt["truncated"] is not False
                or receipt["source_complete_for_supplied_projection"] is not True
                or any(not isinstance(receipt[key], str) or len(receipt[key]) != 64
                       or any(char not in "0123456789abcdef" for char in receipt[key]) for key in hashes)
                or any(type(receipt[key]) is not int or receipt[key] < 0 for key in counts)
                or type(receipt["token_safety_factor"]) is not float
                or receipt["token_safety_factor"] != TOKEN_SAFETY_FACTOR
                or receipt["total_token_budget"] != TOTAL_TOKEN_BUDGET
                or not 0 < receipt["output_reserve_tokens"] <= COMMERCIAL_OUTPUT_TOKEN_CEILING
                or receipt["estimated_input_tokens"] <= 0
                or receipt["tool_schema_estimated_tokens"] > receipt["estimated_input_tokens"]
                or receipt["reserved_input_tokens"] != expected_reserved
                or receipt["reserved_input_tokens"] + receipt["output_reserve_tokens"] <= TOTAL_TOKEN_BUDGET
                or not isinstance(receipt["source_selection"], dict)
                or not isinstance(receipt["previous"], list)
                or not isinstance(receipt["structural_aliases"], list)
                or not isinstance(receipt["section_characters"], dict)
                or set(receipt["section_characters"]) != {"schema_version", "chapter_number", "source_context",
                    "previous_chapters", "current_body", "citation_catalog", "citation_protocol", "coverage_notice"}
                or any(type(size) is not int or size < 0 for size in receipt["section_characters"].values())):
            return False
        try:
            json.dumps(receipt, allow_nan=False)
        except (ValueError, TypeError, OverflowError):
            return False
        return True  # Shape only; persisted-spend/source fences remain mandatory.
    if not isinstance(receipt, dict) or set(receipt) != {
        "schema_version",
        "chapter_number",
        "requested_samples",
        "required_valid_samples",
        "valid_samples",
        "reference_corpus_key",
        "samples",
        "status",
    }:
        return False
    n = receipt["requested_samples"]
    if (
        type(n) is not int
        or n < 1
        or (expected_samples is not None and n != expected_samples)
        or receipt["schema_version"] != "chapter-quality-aggregation.v1"
        or receipt["status"] != "insufficient_valid_samples"
        or type(receipt["chapter_number"]) is not int
        or receipt["chapter_number"] < 1
        or not isinstance(receipt["reference_corpus_key"], str)
        or not receipt["reference_corpus_key"]
        or type(receipt["required_valid_samples"]) is not int
        or receipt["required_valid_samples"] != n // 2 + 1
        or type(receipt["valid_samples"]) is not int
        or receipt["valid_samples"] != 0
        or not isinstance(receipt["samples"], list)
        or len(receipt["samples"]) != n
    ):
        return False
    budget_receipts = []
    for slot, sample in enumerate(receipt["samples"]):
        if (
            not isinstance(sample, dict)
            or set(sample) != {"sample_slot", "valid", "report"}
            or sample["sample_slot"] != f"chapter-quality.independent-v2:{slot}"
            or sample["valid"] is not False
            or not isinstance(sample["report"], Mapping)
            or not _is_unpaid_commercial_placeholder(sample["report"])
        ):
            return False
        if sample["report"].get("raw_excerpt"):
            child = json.loads(sample["report"]["raw_excerpt"])
            if (child.get("schema_version") != "commercial-source-evidence.v3"
                    and child.get("schema") != "commercial-review-transport.v1"):
                return False
            budget_receipts.append(child)
    if budget_receipts and (len(budget_receipts) != n or any(
            item != budget_receipts[0] for item in budget_receipts[1:])):
        return False
    insufficient = LLMQualityJudgeResult.model_validate(
        {
            "scope": "chapter",
            "passed": False,
            "blocking_issues": [
                {
                    "code": "CHAPTER_JUDGE_UNAVAILABLE",
                    "severity": "critical",
                    "evidence": f"Only 0/{n} valid samples; {n // 2 + 1} required.",
                    "required_fix": "Judge-only re-evaluation; no prose verdict is available.",
                }
            ],
            "rewrite_plan": {
                "scope": "judge",
                "instructions": "Insufficient valid judge samples; do not rewrite the chapter.",
            },
            "raw_excerpt": result.raw_excerpt,
        }
    )
    return canonical_unavailable or domain == insufficient.model_dump(mode="json")


async def _assert_no_unbound_commercial_spend(
    session: Any,
    *,
    project_id: UUID,
    chapter_id: UUID,
    body_hash: str,
    scope: str,
    contract: Mapping[str, Any] | None = None,
    current_input_hash: str | None = None,
    effective_critic: Mapping[str, Any] | None = None,
    cohort_samples: int | None = None,
    draft_id: UUID | None = None,
    sources: CommercialSources | None = None,
    settings: Any = None,
) -> None:
    """Before first-cohort credit, reject paid, prepared or opaque orphan evidence.

    Runs/journals for a verifiably different body do not spend this body's cohort.
    Ledger results without a run can name their route, but cannot prove a
    commercial body's identity: such returns remain quarantined, never free draws.
    """
    from sqlalchemy import select

    from bestseller.infra.db.models import (
        ChapterModel,
        ExecutionAttemptModel,
        ExecutionOperationModel,
        LlmRunModel,
        WorkflowRunModel,
    )
    from bestseller.services.llm import _cached_paid_call_origin
    exclusions = {"run_ids": [], "operation_keys": []}
    if contract is not None and current_input_hash and effective_critic:
        from bestseller.services.commercial_protocol_transition_runtime import inspect_authorized_protocol_transition
        transition = await inspect_authorized_protocol_transition(
            session, project_id=project_id, chapter_id=chapter_id, scope=scope,
            evaluation_contract=contract, current_input_hash=current_input_hash,
            effective_critic=effective_critic,
        )
        if transition is not None:
            exclusions = transition

    def digest(value: Any) -> bool:
        return (
            isinstance(value, str)
            and len(value) == 64
            and all(c in "0123456789abcdef" for c in value)
        )

    key = _digest(
        {"project_id": str(project_id), "chapter_id": str(chapter_id), "body_sha256": body_hash}
    )
    chapter = await session.get(ChapterModel, chapter_id)
    if chapter is None or chapter.project_id != project_id:
        raise ValueError("commercial_cohort_orphan_scope_unverified")
    pointers = (chapter.metadata_json or {}).get("commercial_component_cohorts", {})
    if not isinstance(pointers, Mapping) or key in pointers:
        raise ValueError("commercial_cohort_orphan_pointer_requires_recovery")
    workflows = list(
        await session.scalars(
            select(WorkflowRunModel).where(WorkflowRunModel.project_id == project_id)
        )
    )
    workflow_by_id = {row.id: row for row in workflows}
    from bestseller.services.commercial_slot_quarantine import load_verified_historical_quarantine_roots

    historical_quarantines = await load_verified_historical_quarantine_roots(
        session, project_id=project_id, chapter_id=chapter_id, body_sha256=body_hash,
        scope=scope, workflows=workflows,
    )
    for workflow in workflows:
        journals = (workflow.metadata_json or {}).get("commercial_component_cohorts", {})
        if not isinstance(journals, Mapping):
            raise ValueError("commercial_cohort_orphan_journal_unverified")
        if key in journals:
            raise ValueError("commercial_cohort_orphan_journal_requires_recovery")
        if workflow.scope_type == "chapter" and workflow.scope_id != chapter_id:
            continue
        for journal in journals.values():
            binding = journal.get("binding") if isinstance(journal, Mapping) else None
            source = binding.get("source_binding") if isinstance(binding, Mapping) else None
            prior_body = source.get("body_sha256") if isinstance(source, Mapping) else None
            if (
                not isinstance(binding, Mapping)
                or journal.get("schema") != COHORT_SCHEMA
                or binding.get("project_id") != str(project_id)
                or binding.get("chapter_id") != str(chapter_id)
                or not isinstance(source, Mapping)
                or any(not digest(source.get(field)) for field in _BINDING_KEYS)
                or not digest(prior_body)
                or prior_body == body_hash
            ):
                raise ValueError("commercial_cohort_orphan_journal_requires_recovery")
    runs = list(
        await session.scalars(
            select(LlmRunModel).where(
                LlmRunModel.project_id == project_id,
                LlmRunModel.prompt_template == "chapter_commercial_quality_judge",
            )
        )
    )
    for run in runs:
        workflow = workflow_by_id.get(run.workflow_run_id)
        source = (run.metadata_json or {}).get("commercial_source_input_receipt") or {}
        prior_body = source.get("body_sha256") if isinstance(source, Mapping) else None
        if (
            prior_body == body_hash
            and workflow is not None
            and workflow.scope_type == "chapter"
            and workflow.scope_id != chapter_id
        ):
            raise ValueError("commercial_cohort_paid_body_workflow_scope_conflict")
        if (
            workflow is not None
            and workflow.scope_type == "chapter"
            and workflow.scope_id != chapter_id
        ):
            continue
        if str(run.id) in exclusions["run_ids"]:
            continue  # Explicit new-protocol evaluation; no old-body attribution.
        source = (run.metadata_json or {}).get("commercial_source_input_receipt") or {}
        prior_body = source.get("body_sha256") if isinstance(source, Mapping) else None
        if (
            not isinstance(source, Mapping)
            or any(not digest(source.get(field)) for field in _BINDING_KEYS)
            or not digest(prior_body)
            or prior_body == body_hash
        ):
            raise ValueError("commercial_cohort_legacy_paid_result_requires_report")
    operations = list(
        await session.scalars(
            select(ExecutionOperationModel).where(
                ExecutionOperationModel.scope_id == scope,
            )
        )
    )
    operation_keys = {operation.key for operation in operations}
    operation_by_key = {operation.key: operation for operation in operations}
    attempts = list(
        await session.scalars(
            select(ExecutionAttemptModel).where(
                ExecutionAttemptModel.scope_id == scope,
            )
        )
    )
    attempt_by_id = {attempt.id: attempt for attempt in attempts}
    # Early conception calls may retain NULL project ownership. Their original
    # request purpose can still be proven by exact scope/operation/input links;
    # do not turn a missing project attribution into a commercial verdict.
    route_runs = list(await session.scalars(select(LlmRunModel).where(
        LlmRunModel.prompt_hash.in_({operation.input_hash for operation in operations}),
    ))) if operations else []
    from bestseller.services.commercial_protocol_transition_runtime import _row
    from bestseller.services.commercial_request_purpose import prove_known_noncommercial_request

    def purpose_evidence(root):
        return dict(
            operation=_row(root),
            actual_attempts=[_row(a) for a in attempts if a.operation_key == root.key],
            original_runs=[_row(r) for r in route_runs if (
                (r.metadata_json or {}).get("execution_receipt", {}).get("operation_key") == root.key
                and (r.metadata_json or {}).get("execution_receipt", {}).get("scope_id") == scope
                and r.prompt_hash == root.input_hash
            )],
            transport_results=[_row(o) for o in operations if (
                o.status == "transport_result" and isinstance(o.result_json, Mapping)
                and o.result_json.get("operation_key") == root.key
            )],
            failure_receipts=[_row(o) for o in operations if (
                o.status == "transport_failure_receipt" and isinstance(o.result_json, Mapping)
                and o.result_json.get("operation_key") == root.key
            )],
        )

    purpose_proofs = {}
    ambiguous_roots = set()
    for operation in operations:
        from bestseller.services.execution_control_purpose import verify_non_dispatch_control
        if await verify_non_dispatch_control(session,operation=operation,operations=operations,attempts=attempts) is not None:
            continue
        if operation.status == "unsent_reclaim_receipt":
            from bestseller.services.unsent_reclaim_control import validate_unsent_reclaim_control
            validate_unsent_reclaim_control(
                _row(operation), operations=[_row(o) for o in operations],
                actual_attempts=[_row(a) for a in attempts],
            )
            continue  # The parent request still needs independent purpose/financial proof.
        if operation.key in exclusions["operation_keys"]:
            continue  # Exact original snapshots, ALL sends and charged closure revalidated.
        envelope = operation.result_json
        if operation.status in {"reconciliation_receipt", "transport_failure_receipt"}:
            # These are control evidence for an existing request, not another
            # request. Resolve their exact parent; that parent is still checked
            # independently below and gains no replay or credit authorization.
            if not isinstance(envelope, Mapping):
                raise ValueError("commercial_cohort_control_receipt_unverified")
            reconciliation = operation.status == "reconciliation_receipt"
            receipt = envelope.get("receipt") if reconciliation else envelope
            if not isinstance(receipt, Mapping):
                raise ValueError("commercial_cohort_control_receipt_unverified")
            attempt = attempt_by_id.get(receipt.get("attempt_id"))
            parent = operation_by_key.get(attempt.operation_key) if attempt else None
            if (
                attempt is None
                or parent is None
                or parent.key == operation.key
                or parent.status in {"reconciliation_receipt", "transport_failure_receipt"}
                or attempt.input_hash != parent.input_hash
            ):
                raise ValueError("commercial_cohort_control_receipt_parent_mismatch")
            if reconciliation:
                identifier = envelope.get("reconciliation_id")
                key = hashlib.sha256(
                    f"reconciliation.v1\n{scope}\n{identifier}".encode()
                ).hexdigest()
                if (
                    not isinstance(identifier, str)
                    or not identifier
                    or operation.key != key
                    or envelope.get("request_hash") != operation.input_hash
                    or receipt.get("scope_id") != scope
                    or receipt.get("reconciliation_id") != identifier
                    or receipt.get("credit_released") is not False
                    or receipt.get("automatic_resume") is not False
                    or attempt.status != "reconciled_charged"
                    or receipt.get("decision")
                    not in {"abandon_charged", "recover_completed", "quarantine_charged"}
                ):
                    raise ValueError("commercial_cohort_control_receipt_unverified")
                if receipt["decision"] == "quarantine_charged" and (
                    receipt.get("operation_replay_allowed") is not False
                    or receipt.get("remote_outcome") != "unknown_quarantined"
                    or envelope.get("local_dispatcher_stopped") is not True
                    or envelope.get("remote_operation_closed") is not False
                ):
                    raise ValueError("commercial_cohort_control_receipt_unverified")
            else:
                key = hashlib.sha256(
                    f"transport-failure.v1\n{scope}\n{attempt.id}".encode()
                ).hexdigest()
                if (
                    operation.key != key
                    or operation.input_hash != attempt.input_hash
                    or receipt.get("operation_key") != parent.key
                    or receipt.get("schema") != "transport-failure.v1"
                ):
                    raise ValueError("commercial_cohort_control_receipt_unverified")
            continue
        transport = operation.status == "transport_result"
        parent_key = (
            envelope.get("operation_key")
            if transport and isinstance(envelope, Mapping)
            else operation.key
        )
        # A run's source receipt may conclusively exclude this body even when
        # its transport is an unknown result. Match the durable operation too.
        linked = [
            run
            for run in runs
            if (run.metadata_json or {}).get("execution_receipt", {}).get("operation_key")
            == parent_key
            and (run.metadata_json or {}).get("execution_receipt", {}).get("scope_id") == scope
            and run.prompt_hash == operation.input_hash
        ]
        if linked and all(
            digest(
                (run.metadata_json or {})
                .get("commercial_source_input_receipt", {})
                .get("body_sha256")
            )
            and (run.metadata_json or {})["commercial_source_input_receipt"]["body_sha256"]
            != body_hash
            for run in linked
        ):
            continue
        if operation.key in historical_quarantines:
            proof = historical_quarantines[operation.key]
            if (proof["root_sha256"] != _digest(_row(operation))
                    or proof["attempts_sha256"] != _digest(sorted(
                        [_row(a) for a in attempts if a.operation_key == operation.key],
                        key=lambda a: a["id"],
                    ))):
                raise ValueError("commercial_cohort_historical_quarantine_drift")
            continue  # Known other-body purpose; controls above remain independently checked.
        paid = envelope.get("result") if transport and isinstance(envelope, Mapping) else envelope
        if parent_key not in purpose_proofs:
            root = operation_by_key.get(parent_key)
            purpose_proofs[parent_key] = root is not None and prove_known_noncommercial_request(
                **purpose_evidence(root),
                equivalent_requests=[purpose_evidence(other) for other in operations if (
                    root.status == "stopped" and other.status == "completed"
                    and other.key != root.key and other.input_hash == root.input_hash
                )],
            )
        if purpose_proofs[parent_key]:
            continue
        if settings is not None:
            root = operation_by_key[parent_key]
            native_purpose = await prove_native_conception_request(
                session, settings, project_id=project_id, operation=root,
                actual_attempts=[a for a in attempts if a.operation_key == parent_key],
                original_runs=[r for r in route_runs if (
                    (r.metadata_json or {}).get("execution_receipt", {}).get("operation_key")
                        == parent_key
                    and (r.metadata_json or {}).get("execution_receipt", {}).get("scope_id") == scope
                    and r.prompt_hash == root.input_hash)],
                transport_results=[o for o in operations if o.status == "transport_result"
                    and isinstance(o.result_json, Mapping)
                    and o.result_json.get("operation_key") == parent_key],
            )
            if native_purpose is not None:
                continue
        if settings is not None:
            from bestseller.services.legacy_request_purpose import prove_unlabelled_beatsheet_request
            legacy_purpose = await prove_unlabelled_beatsheet_request(
                session,settings,operation=operation_by_key[parent_key],
                actual_attempts=[a for a in attempts if a.operation_key==parent_key],
                original_runs=[r for r in route_runs if (r.metadata_json or {}).get('execution_receipt',{}).get('operation_key')==parent_key
                    and (r.metadata_json or {}).get('execution_receipt',{}).get('scope_id')==scope and r.prompt_hash==operation.input_hash],
                transport_results=[o for o in operations if o.status=='transport_result'
                    and isinstance(o.result_json,Mapping) and o.result_json.get('operation_key')==parent_key],
            )
            if legacy_purpose is not None:
                purpose_proofs[parent_key]=True
                continue
        metadata = paid.get("metadata") if isinstance(paid, Mapping) else None
        origin = _cached_paid_call_origin(dict(metadata) if isinstance(metadata, Mapping) else {})
        if (
            not isinstance(origin, Mapping)
            or origin.get("schema") != "paid-call-origin.v1"
            or origin.get("status") != "recorded"
            or not origin.get("project_id")
            or origin.get("prompt_hash") != operation.input_hash
            or not digest(origin.get("prompt_hash"))
            or not isinstance(origin.get("prompt_template"), str)
            or not origin["prompt_template"]
        ):
            # An explicit operator migration may accept a frozen ambiguity for
            # this new assessment. It never infers purpose from a hash change.
            if any((r.metadata_json or {}).get("execution_receipt", {}).get("operation_key") == parent_key
                   and (r.metadata_json or {}).get("execution_receipt", {}).get("scope_id") == scope
                   and r.prompt_hash == operation.input_hash for r in route_runs):
                raise ValueError("commercial_cohort_opaque_operation_requires_recovery")
            ambiguous_roots.add(parent_key)
            continue
        if origin["project_id"] != str(project_id):
            # The retained origin must actually identify another project.
            try:
                UUID(str(origin["project_id"]))
            except (ValueError, TypeError) as error:
                raise ValueError("commercial_cohort_opaque_operation_requires_recovery") from error
            continue
        origin_workflow = (
            workflow_by_id.get(UUID(origin["workflow_run_id"]))
            if origin.get("workflow_run_id")
            else None
        )
        if (
            origin_workflow is not None
            and origin_workflow.scope_type == "chapter"
            and origin_workflow.scope_id != chapter_id
        ):
            continue
        if origin["prompt_template"] == "chapter_commercial_quality_judge":
            raise ValueError("commercial_cohort_orphan_paid_operation_requires_report")
        # Conflicting tool evidence is not a known unrelated route.
        if "submit_chapter_review" in json.dumps(
            [paid.get("tool_calls"), paid.get("raw_message")], ensure_ascii=False
        ):
            raise ValueError("commercial_cohort_orphan_paid_operation_requires_report")
    if any(attempt.operation_key not in operation_keys for attempt in attempts):
        raise ValueError("commercial_cohort_orphan_attempt_requires_recovery")
    if ambiguous_roots:
        if not (contract is not None and current_input_hash and effective_critic):
            raise ValueError("commercial_cohort_opaque_operation_requires_recovery")
        if sources is not None:
            from bestseller.services.exact_unknown_business import inspect_exact_unknown_business
            isolated = await inspect_exact_unknown_business(session, ambiguous_roots=ambiguous_roots,
                project_id=project_id, chapter_id=chapter_id, draft_id=draft_id, scope=scope,
                sources=sources, evaluation_contract=contract, current_input_hash=current_input_hash,
                effective_critic=effective_critic, samples=cohort_samples)
            ambiguous_roots -= isolated
        if not ambiguous_roots:
            return  # Only exact listed roots were authorized; all other guards above ran.
        from bestseller.services.commercial_protocol_transition_runtime import inspect_ambiguity_retirement
        await inspect_ambiguity_retirement(
            session, project_id=project_id, chapter_id=chapter_id, scope=scope,
            body_hash=body_hash, evaluation_contract=contract, current_input_hash=current_input_hash,
            effective_critic=effective_critic, roots=ambiguous_roots,
            operations=operations, attempts=attempts, cohort_samples=cohort_samples,
            draft_id=draft_id,
        )


async def _historical_commercial_cohort(
    session: Any,
    *,
    project_id: UUID,
    chapter_id: UUID,
    draft_id: UUID,
    body_hash: str,
    content_md: str,
    sources: CommercialSources,
    contract: Mapping[str, Any],
    scope: str,
    n: int,
    expected_model: str,
    current_input_hash: str | None = None,
    effective_critic: Mapping[str, Any] | None = None,
    settings: Any = None,
) -> dict[str, Any] | None:
    from sqlalchemy import or_, select

    from bestseller.infra.db.models import LlmRunModel, ReviewReportModel

    fingerprint = hashlib.sha256(
        content_md.replace("\r\n", "\n").replace("\r", "\n").encode()
    ).hexdigest()
    rows = list(
        await session.scalars(
            select(ReviewReportModel).where(
                ReviewReportModel.project_id == project_id,
                ReviewReportModel.target_type == "chapter",
                ReviewReportModel.target_id == chapter_id,
                or_(
                    ReviewReportModel.structured_output["draft_id"].as_string() == str(draft_id),
                    ReviewReportModel.structured_output["reviewed_body_fingerprint"][
                        "digest"
                    ].as_string()
                    == fingerprint,
                ),
            )
        )
    )
    candidates = []
    consumed_history = False
    slots = [f"chapter-quality.independent-v2:{i}" for i in range(n)]
    for row in rows:
        payload = row.structured_output or {}
        commercial = (payload.get("evidence_summary") or {}).get("llm_commercial_judge")
        if commercial is None:
            continue  # A primary-only report is not a consumed commercial cohort.
        if (
            payload.get("draft_id") != str(draft_id)
            or (payload.get("reviewed_body_fingerprint") or {}).get("digest") != fingerprint
        ):
            raise ValueError("commercial_cohort_exact_draft_body_changed")
        if _is_unpaid_commercial_placeholder(commercial, expected_samples=n):
            continue  # Shape only: the no-candidate exit below still checks spend.
        consumed_history = True
        receipt = json.loads(commercial.get("raw_excerpt") or "")
        if receipt.get("schema_version") == SLOT_RECEIPT_SCHEMA and n == 1:
            samples = [{"sample_slot": slots[0], "report": commercial}]
        else:
            if (
                receipt.get("schema_version") != "chapter-quality-aggregation.v1"
                or receipt.get("requested_samples") != n
            ):
                raise ValueError("commercial_cohort_complete_receipt_required")
            samples = receipt.get("samples") or []
        if len(samples) != n or [s.get("sample_slot") for s in samples] != slots:
            raise ValueError("commercial_cohort_slot_set_changed")
        # The same exact draft may have been judged against an older approved
        # plan. Select the business cohort before comparing its paid proofs;
        # different source/contract histories are neither siblings nor retries.
        identities = []
        for sample in samples:
            envelope = json.loads(sample["report"].get("raw_excerpt") or "")
            if (
                envelope.get("schema_version") != SLOT_RECEIPT_SCHEMA
                or envelope.get("sample_slot") != sample["sample_slot"]
                or not isinstance(envelope.get("source_binding"), dict)
                or any(not envelope["source_binding"].get(k) for k in _BINDING_KEYS)
            ):
                raise ValueError("commercial_cohort_complete_receipt_required")
            run = await session.get(LlmRunModel, UUID(str(sample["report"].get("llm_run_id"))))
            if (
                run is None
                or run.project_id != project_id
                or run.prompt_template != "chapter_commercial_quality_judge"
            ):
                raise ValueError("commercial_cohort_paid_run_mismatch")
            metadata = run.metadata_json or {}
            paid_source = metadata.get("commercial_source_input_receipt") or {}
            if any(paid_source.get(k) != envelope["source_binding"][k] for k in _BINDING_KEYS):
                raise ValueError("commercial_cohort_paid_source_mismatch")
            declared_contract = envelope.get("evaluation_contract")
            if not isinstance(declared_contract, dict) and not (
                declared_contract is None
                and envelope["source_binding"]["source_protocol_sha256"]
                != sources.receipt["source_protocol_sha256"]
            ):
                raise ValueError("commercial_cohort_complete_receipt_required")
            paid_contract = metadata.get("commercial_evaluation_contract")
            if paid_contract is not None and paid_contract != declared_contract:
                raise ValueError("commercial_cohort_paid_contract_mismatch")
            identities.append(
                {
                    "source": envelope["source_binding"],
                    "contract": declared_contract,
                    "scope": (metadata.get("execution_receipt") or {}).get("scope_id"),
                    "model": run.model_name,
                }
            )
        if len({_digest(identity) for identity in identities}) != 1:
            raise ValueError("commercial_cohort_mixed_history_binding")
        if identities[0] != {
            "source": {k: sources.receipt[k] for k in _BINDING_KEYS},
            "contract": dict(contract),
            "scope": scope,
            "model": expected_model,
        }:
            continue  # Keep the original rows; never migrate them as this cohort.
        verified = {}
        for sample in samples:
            result, envelope, run = await _verified_paid_slot(
                session,
                report=sample["report"],
                sources=sources,
                contract=contract,
                project_id=project_id,
                scope=scope,
                slot=sample["sample_slot"],
                expected_model=expected_model, settings=settings,
            )
            verified[sample["sample_slot"]] = {
                "state": "completed",
                "used_attempts": envelope["attempt"],
                "report": result.model_dump(mode="json"),
                "source_report_id": str(row.id),
                "paid_operation_key": (run.metadata_json or {})
                .get("execution_receipt", {})
                .get("operation_key"),
                "recovery": (run.metadata_json or {}).get("commercial_evidence_recovery") or {},
            }
        if len({entry["report"]["llm_run_id"] for entry in verified.values()}) != n:
            raise ValueError("commercial_cohort_independent_paid_slots_required")
        if len({entry["paid_operation_key"] for entry in verified.values()}) != n:
            raise ValueError("commercial_cohort_independent_paid_slots_required")
        candidates.append({"slots": verified, "aggregate": commercial})
    if not candidates:
        if consumed_history:
            raise ValueError("commercial_cohort_no_compatible_retained_history")
        await _assert_no_unbound_commercial_spend(
            session,
            project_id=project_id,
            chapter_id=chapter_id,
            body_hash=body_hash,
            scope=scope,
            contract=contract, current_input_hash=current_input_hash,
            effective_critic=effective_critic,
            cohort_samples=n,
            draft_id=draft_id,
            sources=sources,
            settings=settings,
        )
        return None

    def dominates(new: dict, old: dict) -> bool:
        for slot in slots:
            a, b = new[slot], old[slot]
            if a["used_attempts"] == b["used_attempts"]:
                if a["report"] != b["report"]:
                    return False
            elif (
                a["used_attempts"] != 2
                or b["used_attempts"] != 1
                or not LLMQualityJudgeResult.model_validate(b["report"]).infrastructure_failure
                or a["recovery"].get("prior_llm_run_id") != b["report"].get("llm_run_id")
            ):
                return False
        return True

    winners = [
        c for c in candidates if all(dominates(c["slots"], old["slots"]) for old in candidates)
    ]
    if not winners:
        raise ValueError("commercial_cohort_duplicate_history_ambiguous")
    domains = {
        json.dumps(
            LLMQualityJudgeResult.model_validate(c["aggregate"]).model_dump(
                exclude={"raw_excerpt"}
            ),
            sort_keys=True,
        )
        for c in winners
    }
    if len(domains) != 1:
        raise ValueError("commercial_cohort_duplicate_aggregate_ambiguous")
    return winners[0]


def _component_savepoint(function):
    """Release component locks on failure without rolling back caller work.

    Existing successful checkpoints still commit before dispatch. On a rejected
    proof only the savepoint is rolled back, including locks acquired inside it.
    """
    @wraps(function)
    async def guarded(session, *args, **kwargs):
        savepoint = await session.begin_nested()
        try:
            result = await function(session, *args, **kwargs)
        except BaseException:
            if savepoint.is_active:
                await savepoint.rollback()
            raise
        if savepoint.is_active:
            await savepoint.commit()
        return result

    return guarded


@_component_savepoint
async def prepare_commercial_component_slot(
    session: Any,
    *,
    project_id: UUID,
    chapter_id: UUID,
    draft_id: UUID,
    workflow_run_id: UUID,
    content_md: str,
    sources: CommercialSources,
    evaluation_contract: Mapping[str, Any],
    sample_slot: str,
    samples: int,
    retry_context: Mapping[str, Any] | None,
    effective_critic: Mapping[str, Any],
    retained_only: bool = False,
    current_input_hash: str | None = None,
    settings: Any = None,
) -> tuple[LLMQualityJudgeResult | None, dict[str, Any]]:
    """One business cohort survives primary policy/WF changes and process exits.

    Chapter metadata carries only an audit pointer. Raw retained reports live in
    a workflow journal, outside creative-source metadata. Never grant new rounds
    for a changed commercial contract or for an unknown/exhausted old slot.
    """
    from sqlalchemy import select
    from bestseller.infra.db.models import ChapterDraftVersionModel, ChapterModel, WorkflowRunModel
    from bestseller.services.budget import current_execution_scope
    from bestseller.services.exact_unknown_business import consume_inspected_exact_unknown, inspect_exact_unknown_business

    session.info.pop("exact_unknown_business_verified", None)
    session.info.pop("verified_legacy_noncommercial_requests", None)
    session.info.pop("verified_non_dispatch_controls", None)

    scope = current_execution_scope()
    if not scope:
        raise ValueError("commercial_cohort_execution_scope_required")
    if sample_slot not in {f"chapter-quality.independent-v2:{i}" for i in range(samples)}:
        raise ValueError("commercial_cohort_slot_set_changed")
    chapter = await session.scalar(
        select(ChapterModel)
        .where(ChapterModel.id == chapter_id, ChapterModel.project_id == project_id)
        .execution_options(populate_existing=True)
        .with_for_update()
    )
    draft = await session.get(ChapterDraftVersionModel, draft_id)
    if (
        chapter is None
        or draft is None
        or draft.project_id != project_id
        or draft.chapter_id != chapter_id
        or draft.content_md != content_md
    ):
        raise ValueError("commercial_cohort_exact_binding_required")
    binding = {
        "project_id": str(project_id),
        "chapter_id": str(chapter_id),
        "draft_id": str(draft_id),
        "source_binding": {k: sources.receipt[k] for k in _BINDING_KEYS},
        "evaluation_contract": dict(evaluation_contract),
        "samples": samples,
        "scope_id": scope,
        "effective_critic_sha256": _digest(effective_critic),
    }
    key = _digest(
        {
            "project_id": str(project_id),
            "chapter_id": str(chapter_id),
            "body_sha256": sources.receipt["body_sha256"],
        }
    )
    pointers = deepcopy((chapter.metadata_json or {}).get("commercial_component_cohorts") or {})
    pointer = pointers.get(key)
    owner_id = UUID(pointer["workflow_run_id"]) if pointer else workflow_run_id
    owner = await session.scalar(
        select(WorkflowRunModel)
        .where(
            WorkflowRunModel.id == owner_id,
            WorkflowRunModel.project_id == project_id,
            WorkflowRunModel.scope_id == chapter_id,
            WorkflowRunModel.scope_type == "chapter",
        )
        .execution_options(populate_existing=True)
        .with_for_update()
    )
    if owner is None:
        raise ValueError("commercial_cohort_workflow_scope_mismatch")
    journals = deepcopy((owner.metadata_json or {}).get("commercial_component_cohorts") or {})
    journal = journals.get(key)
    if pointer is not None:
        if (
            journal is None
            or journal.get("schema") != COHORT_SCHEMA
            or pointer.get("binding_sha256") != _digest(binding)
            or journal.get("binding") != binding
        ):
            from bestseller.services.commercial_protocol_successor_runtime import (
                consume_authorized_successor,
            )

            successor = await consume_authorized_successor(
                session, chapter=chapter, old_owner=owner, key=key, pointer=pointer,
                old_journal=journal, binding=binding, workflow_run_id=workflow_run_id,
                sources=sources, current_input_hash=current_input_hash,
                effective_critic=effective_critic,
            ) if not retained_only else None
            if successor is None:
                raise ValueError("commercial_cohort_contract_changed_requires_explicit_recovery")
            owner, journals, journal = successor
        isolation = journal.get("exact_unknown_business")
        from bestseller.services.exact_unknown_business import _identity
        receipt = await session.get(WorkflowRunModel, _identity(key), populate_existing=True)
        if isolation is not None or receipt is not None:
            if retry_context is not None:
                raise ValueError("commercial_cohort_isolation_grants_no_retry")
            if receipt is None or isolation is None:
                raise ValueError("commercial_cohort_isolation_receipt_missing")
            roots = receipt.metadata_json["plan"]["baseline"]["root_keys"]
            await inspect_exact_unknown_business(session, ambiguous_roots=roots,
                project_id=project_id, chapter_id=chapter_id, draft_id=draft_id, scope=scope,
                sources=sources, evaluation_contract=evaluation_contract, current_input_hash=current_input_hash,
                effective_critic=effective_critic, samples=samples)
            if consume_inspected_exact_unknown(session, key=key, current_input_hash=current_input_hash) != isolation:
                raise ValueError("commercial_cohort_isolation_binding_changed")
    else:
        retained = await _historical_commercial_cohort(
            session,
            project_id=project_id,
            chapter_id=chapter_id,
            draft_id=draft_id,
            body_hash=sources.receipt["body_sha256"],
            content_md=content_md,
            sources=sources,
            contract=evaluation_contract,
            scope=scope,
            n=samples,
            expected_model=effective_critic["model"],
            current_input_hash=current_input_hash,
            effective_critic=effective_critic, settings=settings,
        )
        if retained is None and retained_only:
            raise ValueError("commercial_cohort_retained_complete_cohort_required")
        journal = {
            "schema": COHORT_SCHEMA,
            "binding": binding,
            "historical": retained is not None,
            "slots": retained["slots"] if retained else {},
        }
        if session.info.get('verified_legacy_noncommercial_requests'):
            journal['noncommercial_request_purpose_proofs'] = deepcopy(
                session.info['verified_legacy_noncommercial_requests'])
        if session.info.get('verified_non_dispatch_controls'):
            journal['non_dispatch_control_proofs'] = deepcopy(session.info['verified_non_dispatch_controls'])
        if retained is None:
            isolation = consume_inspected_exact_unknown(session, key=key, current_input_hash=current_input_hash)
            if isolation is not None:
                if retry_context is not None:
                    raise ValueError("commercial_cohort_isolation_grants_no_retry")
                journal["exact_unknown_business"] = isolation
            from bestseller.services.commercial_protocol_transition_runtime import persist_inspected_protocol_transition
            transition_ref = await persist_inspected_protocol_transition(
                session, expected_input_hash=current_input_hash,
            )
            if transition_ref is not None:
                journal["legacy_protocol_transition_workflow_id"] = transition_ref
            from bestseller.services.commercial_protocol_transition_runtime import persist_derived_ambiguity_retirement
            ambiguity_ref = await persist_derived_ambiguity_retirement(
                session, expected_input_hash=current_input_hash,
            )
            if ambiguity_ref is not None:
                journal["legacy_ambiguity_retirement_workflow_id"] = ambiguity_ref
        if retained:
            journal["aggregate"] = {
                "slots_sha256": _digest({s: e["report"] for s, e in journal["slots"].items()}),
                "report": retained["aggregate"],
            }
        pointers[key] = {"workflow_run_id": str(owner.id), "binding_sha256": _digest(binding)}
        chapter.metadata_json = {
            **(chapter.metadata_json or {}),
            "commercial_component_cohorts": pointers,
        }
    entry = journal["slots"].get(sample_slot)
    if entry and entry.get("state") in {"prepared", "quarantined"}:
        from bestseller.services.commercial_slot_quarantine import project_quarantined_slot

        quarantined = await project_quarantined_slot(
            session, journal=journal, key=key, owner_id=owner.id, slot=sample_slot,
            source_receipt=sources.receipt, effective_critic=effective_critic,
            current_input_hash=current_input_hash, sources=sources,
        )
        if quarantined is not None:
            result, journal["slots"][sample_slot] = quarantined
            journals[key] = journal
            owner.metadata_json = {
                **(owner.metadata_json or {}), "commercial_component_cohorts": journals,
            }
            await session.flush()
            await session.commit()
            return result, {}
    if retained_only and (entry is None or entry.get("state") != "completed"):
        raise ValueError("commercial_cohort_retained_complete_cohort_required")
    if entry and entry.get("state") not in {"prepared", "completed"}:
        raise ValueError("commercial_cohort_cursor_invalid")
    if entry and entry["state"] == "completed":
        result, envelope, _ = await _verified_paid_slot(
            session,
            report=entry["report"],
            sources=sources,
            contract=evaluation_contract,
            project_id=project_id,
            scope=scope,
            slot=sample_slot,
            expected_model=effective_critic["model"], settings=settings,
        )
        # Only the existing review's explicit second round can advance a first
        # invalid draw. A new primary WF never acquires another commercial round.
        retry = (
            not retained_only
            and not journal["historical"]
            and owner.id == workflow_run_id
            and retry_context is not None
            and retry_context.get("attempt") == 2
            and result.infrastructure_failure
            and envelope["attempt"] == 1
        )
        if not retry:
            journals[key] = journal
            owner.metadata_json = {
                **(owner.metadata_json or {}),
                "commercial_component_cohorts": journals,
            }
            await session.flush()
            await session.commit()
            return result, {}
        entry = {
            "state": "prepared",
            "used_attempts": 2,
            "previous_report": entry["report"],
            "retry_context": deepcopy(retry_context),
        }
    elif entry is None:
        entry = {"state": "prepared", "used_attempts": 1}
    if entry.get("used_attempts") not in (1, 2):
        raise ValueError("commercial_cohort_round_limit")
    journal["slots"][sample_slot] = entry
    journals[key] = journal
    owner.metadata_json = {**(owner.metadata_json or {}), "commercial_component_cohorts": journals}
    await session.flush()
    await session.commit()
    return None, {
        "key": key,
        "owner_id": str(owner.id),
        "slot": sample_slot,
        "attempt": entry["used_attempts"],
        "retry_context": entry.get("retry_context"),
        "namespace": (
            f"commercial-component:{key}:policy:{_digest(evaluation_contract)}:round:{entry['used_attempts']}"
            if journal.get("protocol_successor_workflow_id")
            else f"commercial-component:{key}:round:{entry['used_attempts']}"
        ),
    }


@_component_savepoint
async def save_commercial_component_slot(
    session: Any, binding: Mapping[str, Any], result: LLMQualityJudgeResult
) -> None:
    from sqlalchemy import select
    from bestseller.infra.db.models import WorkflowRunModel

    owner = await session.scalar(
        select(WorkflowRunModel)
        .where(WorkflowRunModel.id == UUID(binding["owner_id"]))
        .execution_options(populate_existing=True)
        .with_for_update()
    )
    journals = deepcopy((owner.metadata_json or {}).get("commercial_component_cohorts") or {})
    journal = journals[binding["key"]]
    entry = journal["slots"][binding["slot"]]
    if entry["used_attempts"] != binding["attempt"]:
        raise ValueError("commercial_cohort_cursor_changed")
    if entry.get("state") == "completed" and entry.get("report") != result.model_dump(mode="json"):
        raise ValueError("commercial_cohort_concurrent_result_changed")
    entry.update(state="completed", report=result.model_dump(mode="json"))
    owner.metadata_json = {**(owner.metadata_json or {}), "commercial_component_cohorts": journals}
    await session.flush()
    await session.commit()


@_component_savepoint
async def freeze_commercial_component_request(
    session: Any, binding: Mapping[str, Any], request: Any, source_receipt: Mapping[str, Any]
) -> tuple[Any, dict[str, Any]]:
    """Freeze exact transport bytes before dispatch, including harmless audit data.

    Semantic equality permits completed reuse, not a new request hash on a
    prepared slot. Never let a new primary workflow or runtime receipt create
    a different gateway operation for an already prepared commercial draw.
    """
    from sqlalchemy import select
    from bestseller.infra.db.models import WorkflowRunModel
    from bestseller.services.llm import LLMCompletionRequest

    owner = await session.scalar(
        select(WorkflowRunModel)
        .where(WorkflowRunModel.id == UUID(binding["owner_id"]))
        .execution_options(populate_existing=True)
        .with_for_update()
    )
    journals = deepcopy((owner.metadata_json or {}).get("commercial_component_cohorts") or {})
    entry = journals[binding["key"]]["slots"][binding["slot"]]
    if entry["used_attempts"] != binding["attempt"]:
        raise ValueError("commercial_cohort_cursor_changed")
    if "request" not in entry:
        isolation = journals[binding["key"]].get("exact_unknown_business")
        if isolation is not None:
            request = request.model_copy(update={"metadata": {**request.metadata,
                "exact_unknown_business_dispatch": deepcopy(isolation)}})
        entry["request"] = request.model_dump(mode="json")
        entry["source_receipt"] = deepcopy(dict(source_receipt))
        owner.metadata_json = {
            **(owner.metadata_json or {}),
            "commercial_component_cohorts": journals,
        }
        await session.flush()
    isolation = journals[binding["key"]].get("exact_unknown_business")
    if isolation is not None and entry["request"].get("metadata", {}).get("exact_unknown_business_dispatch") != isolation:
        raise ValueError("commercial_cohort_isolation_dispatch_guard_changed")
    await session.commit()
    return LLMCompletionRequest.model_validate(entry["request"]), deepcopy(entry["source_receipt"])


@_component_savepoint
async def bind_commercial_component_aggregate(
    session: Any,
    *,
    project_id: UUID,
    chapter_id: UUID,
    content_md: str,
    result: LLMQualityJudgeResult,
) -> LLMQualityJudgeResult:
    from sqlalchemy import select
    from bestseller.infra.db.models import ChapterModel, WorkflowRunModel

    key = _digest(
        {
            "project_id": str(project_id),
            "chapter_id": str(chapter_id),
            "body_sha256": hashlib.sha256(content_md.encode()).hexdigest(),
        }
    )
    chapter = await session.scalar(
        select(ChapterModel)
        .where(ChapterModel.id == chapter_id)
        .execution_options(populate_existing=True)
        .with_for_update()
    )
    pointer = ((chapter.metadata_json or {}).get("commercial_component_cohorts") or {}).get(key)
    if not pointer:
        raise ValueError("commercial_cohort_aggregate_unbound")
    owner = await session.scalar(
        select(WorkflowRunModel)
        .where(WorkflowRunModel.id == UUID(pointer["workflow_run_id"]))
        .execution_options(populate_existing=True)
        .with_for_update()
    )
    journals = deepcopy((owner.metadata_json or {}).get("commercial_component_cohorts") or {})
    journal = journals[key]
    slots = journal["slots"]
    if len(slots) != journal["binding"]["samples"] or any(
        e.get("state") not in {"completed", "quarantined"} for e in slots.values()
    ):
        raise ValueError("commercial_cohort_aggregate_incomplete")
    if any(e.get("state") == "quarantined" for e in slots.values()):
        from bestseller.services.commercial_slot_quarantine import verify_quarantined_aggregate

        await verify_quarantined_aggregate(
            session, journal=journal, key=key, owner_id=owner.id, result=result,
        )
    digest = _digest({s: e["report"] for s, e in slots.items()})
    prior = journal.get("aggregate")
    if prior and prior["slots_sha256"] == digest:
        before = LLMQualityJudgeResult.model_validate(prior["report"])
        if before.model_dump(exclude={"raw_excerpt"}) != result.model_dump(exclude={"raw_excerpt"}):
            raise ValueError("commercial_cohort_aggregate_domain_changed")
        # JSONB can reorder the nested score dictionaries used to render a
        # derived receipt. An unchanged paid cohort already owns its aggregate;
        # retain those exact bytes rather than replacing an equivalent receipt.
        await session.commit()
        return before
    journal["aggregate"] = {"slots_sha256": digest, "report": result.model_dump(mode="json")}
    owner.metadata_json = {**(owner.metadata_json or {}), "commercial_component_cohorts": journals}
    await session.flush()
    await session.commit()
    return result
