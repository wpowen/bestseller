"""Evidence-bound working-pointer and non-evaluation code reconciliation.

This never reviews, grades, adopts, replenishes attempts, or commits. A retained
available review can survive bounded selection/control fixes only when its
original policy bytes and unchanged evaluation/data dependencies are proven.
"""
from __future__ import annotations

import ast
from copy import deepcopy
from datetime import UTC, datetime
import hashlib
from pathlib import Path
from typing import Any
from uuid import UUID

from sqlalchemy import select
from sqlalchemy.ext.asyncio import AsyncSession

from bestseller.infra.db.models import (
    ChapterDraftVersionModel, ChapterModel, ProjectModel, SceneCardModel, WorkflowRunModel,
)


_SELECTION_FUNCTION = "_promote_best_scoring_chapter_draft_on_stall"
_SELECTION_POLICY_FILE = "chapter_draft_candidate_eligibility.py"
_PREFLIGHT_POLICY_FILE = "chapter_review_preflight.py"
_CONTEXT_POLICY_FILE = "context.py"
_ROUTING_POLICY_FILE = "config/model_catalog.yaml"
_EDITOR_CONTROL_POLICY_FILES = {"chapter_rewrite_outcome.py", "rewrite_candidate_evidence.py", "rewrite_repair_source.py", "lossless_rewrite_prompt.py", "lossless_source_encoding.py", "lossless_adopted_span_encoding.py"}
# Frozen physical modules: only the final editor overflow raise becomes the
# existing complete-source delegate (original system/task/source/reserve,
# tools=None) plus derived receipt fields. Normal, V1 and span paths stay exact.
# Whole-file pins also bind every import, helper, protocol and budget reference;
# this is never a license to ignore arbitrary editor-function changes.
_EDITOR_SOURCE_TRANSPORT_SHA_TRANSITIONS = {
    "lossless_rewrite_prompt.py": (
        "481367d4bcbb7e6436416410ba359696811f98d4c009e61a04d68b8e3768fda0",
        "a705c7bd87fa10345d30ca554fa98786a98c7510e3fba8eb2208e0423ececd7e",
    ),
}
_FAILED_REWRITE_GUARD = '''
if chapter_rewrite_task.status == "failed":
    from bestseller.services.chapter_rewrite_outcome import retain_failed_chapter_rewrite_outcome
    await retain_failed_chapter_rewrite_outcome(
        session, workflow=workflow_run, chapter=chapter,
        current_draft=chapter_draft, rewrite_task=chapter_rewrite_task,
    )
    requires_human_review = True
    await _checkpoint_commit(session)
    break
'''
_REWRITE_RETURN_CHECKPOINT = '''
from bestseller.services.chapter_rewrite_outcome import retain_failed_chapter_rewrite_outcome
rejected_rewrite_outcome = await retain_failed_chapter_rewrite_outcome(
    session, workflow=workflow_run, chapter=chapter,
    current_draft=chapter_draft, rewrite_task=chapter_rewrite_task,
)
step_order += 1
await _checkpoint_commit(session)
if rejected_rewrite_outcome is not None:
    requires_human_review = True
    break
'''


def _digest(data: bytes) -> str:
    return hashlib.sha256(data).hexdigest()


def _editor_source_transport_compatibility(name: str, previous: bytes, current: bytes) -> dict[str, Any]:
    approved = _EDITOR_SOURCE_TRANSPORT_SHA_TRANSITIONS.get(name)
    if approved is None or not isinstance(previous, bytes) or not isinstance(current, bytes):
        raise ValueError("review_compatibility_editor_source_file_unverified")
    if (_digest(previous), _digest(current)) != approved:
        raise ValueError("review_compatibility_editor_source_delta_unverified")
    return {
        "schema": "editor-source-transport-compatibility.v1", "file": name,
        "function": "prepare_source_complete_prompt",
        "transition": "editor-final-overflow-complete-source-delegate.v1",
        "previous_source_sha256": approved[0], "current_source_sha256": approved[1],
        "all_other_editor_code_ast_unchanged": True,
        "normal_and_lossless_encoding_paths_unchanged": True,
        "original_system_task_source_output_reserve_unchanged": True,
        "delegate_tools": None, "receipt_metadata_derived_only": True,
        "review_evaluator_changed": False, "grade_reused_across_input_changes": False,
        "budget_increased": False, "new_review_credit": False,
    }


def _normalized_module(source: str) -> str:
    module = ast.parse(source)
    module.body = [node for node in module.body
                   if not isinstance(node, (ast.FunctionDef, ast.AsyncFunctionDef))
                   or node.name != _SELECTION_FUNCTION]
    for node in ast.walk(module):
        if isinstance(node, ast.AsyncFunctionDef) and node.name == "_promote_reviewed_chapter_draft":
            guarded = ast.parse(
                'if draft.promotion_state != DraftPromotionState.ELIGIBLE.value:\n'
                '    await mark_candidate_under_review(\n'
                '        session, project_id=project.id, draft_kind="chapter",\n'
                '        draft_id=draft.id, workflow_run_id=workflow_run_id)\n'
            ).body[0]
            for nested in ast.walk(node):
                for field in ("body", "orelse", "finalbody"):
                    statements = getattr(nested, field, None)
                    if isinstance(statements, list):
                        setattr(nested, field, [guarded.body[0] if ast.dump(statement) == ast.dump(guarded)
                                              else statement for statement in statements])
        if isinstance(node, ast.AsyncFunctionDef) and node.name == "run_chapter_pipeline":
            guarded_preflight = ast.parse(
                "if use_chapter_first and not resume_existing_draft_only and not should_supersede_pending_rewrites:\n"
                "    from bestseller.services.chapter_review_preflight import validate_retained_review_before_processing\n"
                "    await validate_retained_review_before_processing(session, settings, chapter)\n"
            ).body[0]
            node.body = [statement for statement in node.body
                         if ast.dump(statement) != ast.dump(guarded_preflight)]
            # These exact additions preserve rejected editor output before the
            # next review iteration. They cannot change a critic verdict, its
            # source, configuration, or attempt budget.
            rejected_guard = ast.parse(_FAILED_REWRITE_GUARD).body[0]
            checkpoint = ast.parse(_REWRITE_RETURN_CHECKPOINT).body
            checkpoint_ast = [ast.dump(statement) for statement in checkpoint]
            for nested in ast.walk(node):
                for field in ("body", "orelse", "finalbody"):
                    statements = getattr(nested, field, None)
                    if not isinstance(statements, list):
                        continue
                    statements = [statement for statement in statements
                                  if ast.dump(statement) != ast.dump(rejected_guard)]
                    for index in range(len(statements) - len(checkpoint) + 1):
                        if [ast.dump(statement) for statement in statements[index:index + len(checkpoint)]] == checkpoint_ast:
                            statements[index:index + len(checkpoint)] = [checkpoint[2]]
                            break
                    setattr(nested, field, statements)
        if isinstance(node, ast.AsyncFunctionDef) and node.name == "_chapter_critic_semantic_dependencies":
            # The actual gateway already applies this profile. Only the exact
            # local canonicalization may differ; all dependency data/config
            # fields and validation logic must still match the old evaluator.
            canonicalization = ast.parse(
                "from bestseller.settings import apply_runtime_llm_profile\n"
                "settings = apply_runtime_llm_profile(settings)\n"
            ).body
            offset = int(bool(node.body and isinstance(node.body[0], ast.Expr)
                              and isinstance(node.body[0].value, ast.Constant)
                              and isinstance(node.body[0].value.value, str)))
            if [ast.dump(value) for value in node.body[offset:offset + 2]] == [
                ast.dump(value) for value in canonicalization
            ]:
                del node.body[offset:offset + 2]
        if isinstance(node, ast.FunctionDef) and node.name == "chapter_review_recovery_source_hash":
            node.body = [statement for statement in node.body if not (
                isinstance(statement, ast.Expr) and isinstance(statement.value, ast.Call)
                and isinstance(statement.value.func, ast.Attribute) and statement.value.func.attr == "add"
                and isinstance(statement.value.func.value, ast.Name) and statement.value.func.value.id == "policy_files"
                and len(statement.value.args) == 1 and isinstance(statement.value.args[0], ast.BinOp)
                and isinstance(statement.value.args[0].left, ast.Name) and statement.value.args[0].left.id == "root"
                and isinstance(statement.value.args[0].op, ast.Div)
                and isinstance(statement.value.args[0].right, ast.Constant)
                and statement.value.args[0].right.value == _ROUTING_POLICY_FILE
            )]
            for inventory in ast.walk(node):
                if isinstance(inventory, ast.Tuple) and any(
                    isinstance(value, ast.Constant) and value.value == "pipelines.py"
                    for value in inventory.elts
                ):
                    inventory.elts = [value for value in inventory.elts if not (
                        isinstance(value, ast.Constant) and value.value in {
                            _SELECTION_POLICY_FILE, _CONTEXT_POLICY_FILE, _PREFLIGHT_POLICY_FILE,
                            *_EDITOR_CONTROL_POLICY_FILES}
                    )]
        if isinstance(node, ast.Call) and isinstance(node.func, ast.Name) and node.func.id == _SELECTION_FUNCTION:
            node.keywords = [kw for kw in node.keywords if not (
                kw.arg == "settings" and isinstance(kw.value, ast.Name) and kw.value.id == "settings"
            )]
    return ast.dump(module, include_attributes=False)


