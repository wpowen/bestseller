"""Pure, post-verification action view; never rewrites a paid cohort or grade."""

from __future__ import annotations

from collections.abc import Mapping
from copy import deepcopy
from datetime import UTC, datetime
import hashlib
import json
import math
import re
import statistics
from typing import Any
from uuid import UUID

from bestseller.domain.llm_quality_judge import (
    LLMQualityIssue, LLMQualityJudgeResult, quality_judge_result_from_mapping,
)
from bestseller.services.commercial_review_wire import ADAPTER_VERSION, WIRE_VERSION, parse_commercial_wire
from bestseller.services.commercial_source_evidence import (
    CommercialSources, commercial_judge_unavailable, resolve_commercial_source_pointer,
)
from bestseller.services.quality_contract_registry import QUALITY_CONTRACT_VERSION, get_quality_contract
from bestseller.services.write_gate import GateConfig, resolve_mode

POLICY = "commercial-action-projection.v1"
_BINDING = ("body_sha256", "semantic_source_sha256", "previous_sha256", "source_protocol_sha256")
_CRAFT_DOMAINS = frozenset({"prose", "retention", "ending", "pov", "dialogue", "pacing"})
_QUARANTINE = "commercial-slot-quarantine.v1"
_VERIFIED_QUARANTINE = "verified-quarantined-slot-action.v1"


def _json(value: Any) -> str:
    return json.dumps(value, ensure_ascii=False, sort_keys=True, separators=(",", ":"), allow_nan=False)


def _sha(value: Any) -> str:
    return hashlib.sha256(_json(value).encode()).hexdigest()


class _Reject(ValueError):
    def __init__(self, reason: str, status: str = "blocked"):
        self.reason, self.status = reason, status


def _require(condition: bool, reason: str, status: str = "blocked") -> None:
    if not condition:
        raise _Reject(reason, status)


def _hash_proof(value):
    return isinstance(value, str) and re.fullmatch(r"[0-9a-f]{64}", value) is not None


def _decode(raw: str) -> dict[str, Any]:
    def unique(pairs):
        result = {}
        for key, value in pairs:
            _require(key not in result, "duplicate_json_field")
            result[key] = value
        return result

    value = json.loads(raw, object_pairs_hook=unique,
                       parse_constant=lambda value: (_ for _ in ()).throw(_Reject("nonfinite_json")))
    _require(isinstance(value, dict), "receipt_not_object")
    return value


def _typed(result: LLMQualityJudgeResult) -> dict[str, Any]:
    return result.model_dump(mode="json", exclude={"raw_excerpt", "llm_run_id"})


def _result(value):
    result = LLMQualityJudgeResult.model_validate(value)
    if isinstance(value, Mapping):
        _require(result.model_dump(mode="json", by_alias="pass" in value) == dict(value), "typed_snapshot_not_exact")
    return result


def _source_catalog(payload, sources):
    def expand(value):
        if isinstance(value, dict):
            if set(value) == {"$ref"}:
                return expand(resolve_commercial_source_pointer(payload, value["$ref"]))
            return {k: expand(v) for k, v in value.items()}
        return [expand(v) for v in value] if isinstance(value, list) else value

    rows = payload["citation_catalog"]
    _require(len(rows) == len(sources.catalog) and len({r["id"] for r in rows}) == len(rows), "source_catalog_changed")
    for row in rows:
        entry = sources.catalog[row["id"]]
        _require(row["kind"] == entry["kind"], "source_catalog_kind_changed")
        resolved = expand(resolve_commercial_source_pointer(payload, row["source_ref"]))
        if row["kind"] in {"current", "prior"}:
            _require(row["start"] == entry["start"] and row["end"] == entry["end"], "source_offsets_changed")
            text = resolved[row["start"]:row["end"]]
        elif row["kind"] == "observation":
            text = next((resolved[k] for k in ("text", "evidence", "value")
                         if isinstance(resolved, dict) and isinstance(resolved.get(k), str) and resolved[k].strip()),
                        _json(resolved) if isinstance(resolved, dict) else str(resolved))
        else:
            _require(row["kind"] == "constraint", "unsupported_catalog_kind", "unsupported")
            text = _json(resolved)
        _require(text == entry["text"], "source_catalog_text_changed")
    return expand(payload["source_context"])


def _missing_submission_errors(submission: object) -> tuple[str, ...]:
    """Recognize only a retained empty submission, never infer an unretained call.

    The caller still authenticates the full physical return and financial rows.
    Only null/[] can be reconstructed exactly from this receipt without arguments.
    """
    _require(isinstance(submission, dict) and set(submission) == {
        "policy", "status", "calls_received", "tools_executed", "tool_calls_sha256",
    } and submission.get("policy") == "commercial-report-submission.v1"
        and submission.get("status") == "rejected"
        and type(submission.get("calls_received")) is int and submission["calls_received"] == 0
        and type(submission.get("tools_executed")) is int and submission["tools_executed"] == 0
        and submission.get("tool_calls_sha256") in {_sha(None), _sha([])},
        "submission_unverified", "unsupported")
    return ("submission: exactly one review tool call required",)


def _quarantined_slot(
    result: LLMQualityJudgeResult, envelope: dict[str, Any], slot: str,
    sources: CommercialSources, verified: Mapping[str, Any], receipts: list[dict[str, Any]],
) -> tuple[LLMQualityJudgeResult, dict[str, Any]]:
    """Check a loader-authenticated immutable closure; contribute no quality evidence.

    This checks the supplied proof's exact report, full source receipt and all
    internal physical identities. The async loader owns DB authentication and
    the original journal/request/owner binding; this pure consumer grants none.
    """
    _require(
        isinstance(verified, Mapping)
        and set(verified)
        == {
            "schema",
            "proof",
            "source_binding",
            "evaluation_contract",
            "original_report_sha256",
        }
        and verified.get("schema") == _VERIFIED_QUARANTINE,
        "quarantine_verification_required",
    )
    original = result.model_dump(mode="json")
    _require(verified["original_report_sha256"] == _sha(original), "quarantine_report_changed")
    binding = {key: sources.receipt[key] for key in _BINDING}
    _require(verified["source_binding"] == binding, "quarantine_source_changed")
    proof = verified["proof"]
    _require(
        isinstance(proof, dict)
        and set(proof)
        == ({
            "schema",
            "scope_id",
            "cohort_key",
            "slot",
            "round",
            "namespace",
            "input_hash",
            "request_sha256",
            "source_receipt_sha256",
            "effective_critic",
            "root",
            "attempts",
            "failures",
            "reconciliations",
        } | ({"round2_input_binding"} if proof.get("round") == 2 else set()))
        and proof.get("schema") == _QUARANTINE,
        "quarantine_proof_shape_changed",
    )
    _require(
        set(envelope) == {"schema", "operation_key", "sample_slot", "attempt", "proof_sha256"}
        and envelope["proof_sha256"] == _sha(proof),
        "quarantine_proof_hash_changed",
    )
    _require(
        proof["slot"] == envelope["sample_slot"] == slot
        and type(proof["round"]) is int
        and proof["round"] in (1, 2)
        and type(envelope["attempt"]) is int
        and envelope["attempt"] == proof["round"],
        "quarantine_slot_round_changed",
    )
    _require(
        all(
            _hash_proof(proof[k])
            for k in ("cohort_key", "input_hash", "request_sha256", "source_receipt_sha256")
        )
        and proof["source_receipt_sha256"] == _sha(dict(sources.receipt)),
        "quarantine_source_receipt_changed",
    )
    round2_binding = proof.get("round2_input_binding")
    if proof["round"] == 2:
        _require(
            isinstance(round2_binding, Mapping)
            and set(round2_binding) == {
                "base_input_hash", "final_input_hash", "retry_context_sha256", "sources",
            }
            and all(_hash_proof(round2_binding.get(k)) for k in (
                "base_input_hash", "final_input_hash", "retry_context_sha256",
            ))
            and round2_binding["final_input_hash"] == proof["input_hash"]
            and round2_binding["base_input_hash"] != round2_binding["final_input_hash"],
            "quarantine_round2_input_binding_changed",
        )
        retained_sources = round2_binding["sources"]
        _require(
            isinstance(retained_sources, Mapping)
            and set(retained_sources) == {"text", "catalog", "receipt"}
            and retained_sources["text"] == sources.text
            and _json(retained_sources["catalog"]) == _json(dict(sources.catalog))
            and _json(retained_sources["receipt"]) == _json(dict(sources.receipt)),
            "quarantine_round2_sources_changed",
        )
    scope, cohort, round_no = proof["scope_id"], proof["cohort_key"], proof["round"]
    contract = verified["evaluation_contract"]
    _require(
        isinstance(scope, str) and 0 < len(scope) <= 256 and isinstance(contract, dict),
        "quarantine_binding_missing",
    )
    _require(
        proof["namespace"]
        in {
            f"commercial-component:{cohort}:round:{round_no}",
            f"commercial-component:{cohort}:policy:{_sha(contract)}:round:{round_no}",
        },
        "quarantine_cohort_changed",
    )
    subject = f"critic:chapter_commercial_quality_judge:{sources.receipt['prompt_version']}"
    operation = "semantic.v1:" + _sha([proof["namespace"], subject, proof["input_hash"]])
    root_key = hashlib.sha256(f"{scope}\n{operation}:sample:{slot}".encode()).hexdigest()
    root, critic = proof["root"], proof["effective_critic"]
    _require(
        isinstance(root, dict)
        and root.get("key") == envelope["operation_key"] == root_key
        and root.get("scope_id") == scope
        and root.get("input_hash") == proof["input_hash"]
        and root.get("status") == "stopped"
        and root.get("result_json") is None
        and isinstance(root.get("owner"), str)
        and bool(root["owner"])
        and isinstance(critic, dict)
        and isinstance(critic.get("model"), str)
        and bool(critic["model"]),
        "quarantine_root_changed",
    )
    attempts, failures, reconciliations = (
        proof[k] for k in ("attempts", "failures", "reconciliations")
    )
    _require(
        all(isinstance(rows, list) for rows in (attempts, failures, reconciliations))
        and bool(attempts)
        and len(attempts) == len(failures) == len(reconciliations),
        "quarantine_physical_closure_incomplete",
    )
    ids = [a["id"] for a in attempts]
    _require(
        all(isinstance(aid, str) and bool(aid) for aid in ids) and len(set(ids)) == len(ids),
        "quarantine_attempt_set_changed",
    )
    projects, owners = set(), set()
    used_receipts = set()
    for attempt in attempts:
        aid = attempt["id"]
        _require(
            attempt.get("scope_id") == scope
            and attempt.get("operation_key") == root_key
            and attempt.get("input_hash") == proof["input_hash"]
            and attempt.get("model_name") == critic["model"]
            and attempt.get("status") == "reconciled_charged"
            and attempt.get("actual_tokens") is None
            and type(attempt.get("reserved_tokens")) is int
            and attempt["reserved_tokens"] > 0,
            "quarantine_attempt_changed",
        )
        failure_key = hashlib.sha256(f"transport-failure.v1\n{scope}\n{aid}".encode()).hexdigest()
        matches = [row for row in failures if row.get("key") == failure_key]
        _require(len(matches) == 1, "quarantine_failure_missing")
        failure = matches[0]
        diagnostic = failure.get("result_json") or {}
        _require(
            failure.get("scope_id") == scope
            and failure.get("input_hash") == proof["input_hash"]
            and failure.get("owner") == root["owner"]
            and failure.get("status") == "transport_failure_receipt"
            and diagnostic.get("schema") == "transport-failure.v1"
            and diagnostic.get("operation_key") == root_key
            and diagnostic.get("attempt_id") == aid
            and type(diagnostic.get("physical_sends")) is int
            and diagnostic["physical_sends"] == 1
            and diagnostic.get("prompt_template") == "chapter_commercial_quality_judge"
            and diagnostic.get("logical_role") == "critic"
            and diagnostic.get("partial_stream_observed") is False
            and isinstance(diagnostic.get("project_id"), str)
            and bool(diagnostic["project_id"])
            and isinstance(diagnostic.get("workflow_run_id"), str)
            and bool(diagnostic["workflow_run_id"]),
            "quarantine_failure_changed",
        )
        projects.add(diagnostic["project_id"])
        owners.add(diagnostic["workflow_run_id"])
        matches = [
            row
            for row in reconciliations
            if (row.get("result_json") or {}).get("receipt", {}).get("attempt_id") == aid
        ]
        _require(len(matches) == 1, "quarantine_reconciliation_missing")
        saved = matches[0]
        record = saved["result_json"]
        receipt = record["receipt"]
        _require(
            set(record)
            == {
                "reconciliation_id",
                "request_hash",
                "actor",
                "evidence_kind",
                "evidence_sha256",
                "remote_operation_closed",
                "local_dispatcher_stopped",
                "at",
                "receipt",
            }
            and set(receipt)
            == {
                "scope_id",
                "reconciliation_id",
                "attempt_id",
                "decision",
                "status",
                "remaining_unknown",
                "calls_used",
                "tokens_charged",
                "automatic_resume",
                "credit_released",
                "remote_outcome",
                "operation_replay_allowed",
            },
            "quarantine_reconciliation_shape_changed",
        )
        identifier = record["reconciliation_id"]
        _require(
            isinstance(identifier, str)
            and bool(identifier)
            and isinstance(record["actor"], str)
            and bool(record["actor"].strip())
            and _hash_proof(record["evidence_sha256"])
            and record["evidence_kind"] == "dispatcher_exit"
            and record["remote_operation_closed"] is False
            and record["local_dispatcher_stopped"] is True,
            "quarantine_dispatcher_exit_changed",
        )
        evidence = {
            k: record[k]
            for k in (
                "reconciliation_id",
                "actor",
                "evidence_kind",
                "evidence_sha256",
                "remote_operation_closed",
                "local_dispatcher_stopped",
            )
        }
        evidence.update(
            attempt_id=aid,
            expected_input_hash=proof["input_hash"],
            decision="quarantine_charged",
            result=None,
        )
        saved_key = hashlib.sha256(f"reconciliation.v1\n{scope}\n{identifier}".encode()).hexdigest()
        at, created = (
            datetime.fromisoformat(record["at"]),
            datetime.fromisoformat(attempt["created_at"]),
        )
        if created.tzinfo is None:
            created = created.replace(tzinfo=UTC)
        _require(
            saved.get("key") == saved_key
            and saved.get("scope_id") == scope
            and saved.get("status") == "reconciliation_receipt"
            and saved.get("owner") == "manual-reconciliation"
            and saved.get("input_hash") == record["request_hash"] == _sha(evidence)
            and at.tzinfo is not None
            and at >= created
            and receipt["scope_id"] == scope
            and receipt["reconciliation_id"] == identifier
            and receipt["attempt_id"] == aid
            and receipt["decision"] == "quarantine_charged"
            and receipt["remote_outcome"] == "unknown_quarantined"
            and receipt["credit_released"] is False
            and receipt["automatic_resume"] is False
            and receipt["operation_replay_allowed"] is False
            and receipt["status"] in {"active", "unknown", "exhausted", "cancelled"}
            and type(receipt["remaining_unknown"]) is int
            and receipt["remaining_unknown"] >= 0
            and type(receipt["calls_used"]) is int
            and receipt["calls_used"] >= 1
            and type(receipt["tokens_charged"]) is int
            and receipt["tokens_charged"] >= attempt["reserved_tokens"],
            "quarantine_reconciliation_changed",
        )
        _require(saved_key not in used_receipts, "quarantine_receipt_reused")
        used_receipts.add(saved_key)
    _require(len(projects) == len(owners) == 1, "quarantine_owner_changed")
    # The exact producer report has no grade, paid LlmRun, or body rewrite.
    neutral = LLMQualityJudgeResult.model_validate(
        {
            "scope": "chapter",
            "passed": False,
            "overall_score": 0,
            "dimension_scores": {},
            "llm_run_id": None,
            "blocking_issues": [
                {
                    "code": "CHAPTER_JUDGE_UNAVAILABLE",
                    "severity": "critical",
                    "evidence": "Paid slot quarantined with unknown remote outcome; no grade.",
                    "required_fix": "Retain the charged slot; no replay, replacement sample or prose rewrite.",
                }
            ],
            "rewrite_plan": {
                "scope": "judge",
                "instructions": "No retry or chapter rewrite is authorized.",
            },
            "raw_excerpt": result.raw_excerpt,
        }
    )
    _require(
        _json(original) == _json(neutral.model_dump(mode="json")) and result.infrastructure_failure,
        "quarantine_neutral_report_changed",
    )
    receipts.append(
        {
            "sample_slot": slot,
            "status": "unknown",
            "abstains": True,
            "domain_issues_contributed": 0,
            "actions_contributed": 0,
            "scores_contributed": 0,
            "quarantine_proof_sha256": envelope["proof_sha256"],
            "original_report_sha256": _sha(original),
            "source_binding": deepcopy(binding),
            "scope_id": scope,
            "cohort_key": cohort,
            "round": round_no,
            "evaluation_contract": deepcopy(contract),
        }
    )
    if round2_binding is not None:
        receipts[-1]["round2_input_binding_sha256"] = _sha(round2_binding)
    return result, contract


def _slot(report, slot, sources, domains, receipts, verified_quarantine=None):
    result = _result(report)
    envelope = _decode(result.raw_excerpt)
    if envelope.get("schema") == _QUARANTINE and verified_quarantine is not None:
        return _quarantined_slot(result, envelope, slot, sources, verified_quarantine, receipts)
    _require(envelope.get("schema_version") == "commercial-slot-evidence.v1",
             "unsupported_slot_schema", "unsupported")
    _require(envelope.get("sample_slot") == slot, "slot_changed")
    _require(type(envelope.get("attempt")) is int and envelope["attempt"] in (1, 2), "attempt_invalid")
    binding = {key: sources.receipt[key] for key in _BINDING}
    _require(envelope.get("source_binding") == binding, "source_binding_changed")
    contract = envelope.get("evaluation_contract")
    _require(isinstance(contract, dict) and contract.get("schema") == "commercial-evaluation-contract.v1",
             "evaluation_contract_missing", "unsupported")
    _require(contract.get("wire_version") == WIRE_VERSION and contract.get("adapter_version") == ADAPTER_VERSION,
             "unsupported_historical_adapter", "unsupported")
    _require(contract.get("source_protocol_sha256") == binding["source_protocol_sha256"], "contract_source_changed")
    _require(all(_hash_proof(contract.get(key)) for key in (
        "model_catalog_sha256", "system_prompt_sha256", "instruction_prefix_sha256",
        "tools_sha256", "critic_configuration_sha256")), "retained_policy_manifest_missing", "unsupported")
    minimum, dimensions = contract.get("min_overall"), contract.get("min_dimensions")
    _require(type(minimum) in (int, float) and math.isfinite(minimum) and 0 <= minimum <= 1
             and isinstance(dimensions, dict) and all(
                 isinstance(k, str) and type(v) in (int, float) and math.isfinite(v) and 0 <= v <= 1
                 for k, v in dimensions.items()), "threshold_contract_invalid")
    raw = envelope.get("raw_report")
    _require(isinstance(raw, str) and hashlib.sha256(raw.encode()).hexdigest() == envelope.get("raw_report_sha256"),
             "raw_report_hash_changed")
    adapter = envelope.get("adapter_receipt")
    _require(isinstance(adapter, dict), "adapter_missing", "unsupported")
    _require(adapter.get("adapter_version") == ADAPTER_VERSION and adapter.get("wire_version") == WIRE_VERSION,
             "unsupported_adapter_receipt", "unsupported")
    retained_source = adapter.get("source_binding")
    _require(isinstance(retained_source, dict), "adapter_source_missing", "unsupported")
    _require(all(retained_source.get(key) == value for key, value in binding.items()), "adapter_source_changed")
    audit = envelope.get("exact_source_audit")
    _require(isinstance(audit, dict) and all(_hash_proof(audit.get(key)) and _hash_proof(retained_source.get(key))
             for key in ("body_sha256", "previous_sha256", "source_sha256", "assembled_source_sha256")),
             "historical_source_proof_missing", "unsupported")
    _require(audit.get("body_sha256") == binding["body_sha256"]
             and audit.get("previous_sha256") == binding["previous_sha256"], "historical_audit_binding_changed")
    _require(all(audit.get(key) == retained_source.get(key)
                 for key in ("source_sha256", "assembled_source_sha256")), "historical_audit_changed")
    submission = adapter.get("submission", {})
    truncated = (
        result.infrastructure_failure
        and adapter.get("status") == "not_run_output_truncated"
        and envelope.get("validation_errors") == ["output: truncated at structured-review reserve"]
    )
    if adapter.get("status") == "not_run_output_truncated":
        # A length stop may have no tool call at all. Authenticate its exact
        # neutral receipt before requiring a received (voting) submission.
        _require(truncated, "unknown_slot_proof_unsupported", "unsupported")
        _require(set(adapter) == {"adapter_version", "wire_version", "source_binding",
                                  "status", "submission"}, "unknown_adapter_changed")
        try:
            run_id = str(UUID(result.llm_run_id)) if result.llm_run_id else None
        except (ValueError, TypeError, AttributeError):
            run_id = None
        _require(run_id is not None and run_id == result.llm_run_id,
                 "paid_run_identity_missing", "unsupported")
    rejected_submission = (
        result.infrastructure_failure and adapter.get("status") == "rejected_submission"
    )
    _require(isinstance(submission, dict), "submission_unverified", "unsupported")
    if truncated:
        _require(set(submission) == {"policy", "status", "calls_received", "tools_executed",
                                     "tool_calls_sha256"}, "submission_unverified", "unsupported")
    if rejected_submission or (truncated and submission.get("status") == "rejected"):
        _require(bool(result.llm_run_id), "paid_run_identity_missing", "unsupported")
        submission_errors = _missing_submission_errors(submission)
    else:
        submission_errors = ()
        _require(submission.get("policy") == "commercial-report-submission.v1"
                 and submission.get("status") == "received" and type(submission.get("calls_received")) is int
                 and submission["calls_received"] == 1 and type(submission.get("tools_executed")) is int
                 and submission["tools_executed"] == 0 and _hash_proof(submission.get("tool_calls_sha256")),
                 "submission_unverified", "unsupported")
    _require(envelope.get("original_overall_score") == result.overall_score
             and envelope.get("original_dimension_scores") == dict(result.dimension_scores), "slot_scores_changed")
    parsed, rebuilt_adapter, errors = ({}, {}, ()) if truncated else parse_commercial_wire(raw, sources)
    if result.infrastructure_failure:
        retained_errors = envelope.get("validation_errors")
        _require(truncated or ((bool(errors) or bool(submission_errors))
                              and retained_errors == list((*submission_errors, *errors))),
                 "unknown_slot_proof_unsupported", "unsupported")
        if truncated:
            base = LLMQualityJudgeResult(llm_run_id=result.llm_run_id)
        else:
            if rejected_submission:
                expected_adapter = {
                    **rebuilt_adapter, "source_binding": retained_source,
                    "wire_validation_status": rebuilt_adapter["status"],
                    "status": "rejected_submission", "submission": submission,
                }
                _require(adapter == expected_adapter, "unknown_adapter_changed")
            else:
                _require(all(adapter.get(key) == value for key, value in rebuilt_adapter.items() if key != "source_binding"),
                         "unknown_adapter_changed")
            try:
                base = quality_judge_result_from_mapping(parsed, scope="chapter", min_overall=minimum,
                                                         min_dimensions=dimensions, llm_run_id=result.llm_run_id)
            except (ValueError, TypeError):
                base = LLMQualityJudgeResult(llm_run_id=result.llm_run_id)
        unknown = commercial_judge_unavailable(diagnostic=result.blocking_issues[0].evidence, result=base)
        _require(_typed(unknown) == _typed(result), "unknown_typed_slot_changed")
        abstention = {
            "sample_slot": slot, "status": "unknown",
            "raw_report_sha256": envelope["raw_report_sha256"],
            "envelope_sha256": _sha(envelope), "evaluation_contract": deepcopy(contract),
        }
        if rejected_submission or truncated:
            abstention.update(
                abstains=True, domain_issues_contributed=0,
                llm_run_id=result.llm_run_id, validation_errors=deepcopy(retained_errors),
                adapter_receipt=deepcopy(adapter), exact_source_audit=deepcopy(audit),
                original_report=(deepcopy(report) if isinstance(report, Mapping)
                                 else report.model_dump(mode="json")),
            )
            if truncated:
                abstention.update(actions_contributed=0, scores_contributed=0)
        receipts.append(abstention)
        return result, contract
    _require(all(adapter.get("source_binding", {}).get(key) == value for key, value in binding.items()),
             "adapter_source_changed")
    _require(bool(result.llm_run_id), "paid_run_identity_missing", "unsupported")
    _require(not errors and envelope.get("validation_errors") == [], "raw_report_unverified")
    _require(all(adapter.get(key) == value for key, value in rebuilt_adapter.items() if key != "source_binding"),
             "adapter_result_changed")
    rebuilt = quality_judge_result_from_mapping(parsed, scope="chapter", min_overall=minimum,
                                                min_dimensions=dimensions, llm_run_id=result.llm_run_id)
    _require(_typed(rebuilt) == _typed(result), "typed_slot_changed")
    # Correlate full typed evidence with its lossy domain object, never by code
    # alone. The raw wire owns assessment_kind and all source quotations.
    for group in ("blocking_issues", "audit_issues"):
        for index, issue in enumerate(parsed[group]):
            typed = LLMQualityIssue.model_validate(issue).model_dump(mode="json")
            domains.setdefault(_json(typed), []).append({
                "sample_slot": slot, "mapped_group": group, "mapped_index": index,
                "raw_report_sha256": envelope["raw_report_sha256"], "issue": deepcopy(issue),
            })
    raw_keys = {_json(LLMQualityIssue.model_validate(issue).model_dump(mode="json"))
                for group in ("blocking_issues", "audit_issues") for issue in parsed[group]}
    for issue in rebuilt.blocking_issues:
        typed = issue.model_dump(mode="json")
        if _json(typed) not in raw_keys:
            domains.setdefault(_json(typed), []).append({
                "sample_slot": slot, "mapped_group": "blocking_issues", "mapped_index": None,
                "raw_report_sha256": envelope["raw_report_sha256"],
                "derivation": "retained_contract_threshold_normalization",
                "issue": {**typed, "assessment_kind": "retained_threshold_policy"},
            })
    receipts.append({"sample_slot": slot, "status": "verified", "llm_run_id": result.llm_run_id,
                     "raw_report_sha256": envelope["raw_report_sha256"],
                     "envelope_sha256": _sha(envelope), "evaluation_contract": deepcopy(contract),
                     "raw_pass": _decode(raw.strip()[8:-4] if raw.strip().startswith("```json\n") else raw)["pass"],
                     "original_source_audit": deepcopy(envelope.get("exact_source_audit"))})
    return result, contract


def project_commercial_actions(
    aggregate: LLMQualityJudgeResult | Mapping[str, Any], *, sources: CommercialSources,
    gate_config: GateConfig, chapter_number: int,
    verified_quarantine_slots: Mapping[str, Mapping[str, Any]] | None = None,
) -> tuple[dict[str, Any] | None, dict[str, Any]]:
    """Revalidate a strictly verified stable return, then derive a new review view.

    This is not a substitute for the caller's physical paid-operation/cohort
    verification. No current catalog, settings, filesystem, database or provider
    is consulted. Retained contracts/manifests are recorded, never replaced.
    Unsupported receipts cannot grant acceptance. Scalars are not regraded.
    Quarantined slots require the complete exact proof mapping authenticated by
    the caller's async ledger/journal loader; they contribute only abstentions.
    """
    receipt = {"schema": POLICY, "status": "blocked", "scores_modified": False,
               "raw_cohort_modified": False, "grants_slots": False, "authorizes_replay": False}
    try:
        _require(isinstance(gate_config, GateConfig), "gate_config_required", "unsupported")
        _require(gate_config.default in {"block", "audit_only"} and all(
            isinstance(k, str) and v in {"block", "audit_only"} for k, v in gate_config.mode_by_violation.items()),
            "gate_config_invalid", "unsupported")
        _require(isinstance(sources, CommercialSources) and isinstance(sources.catalog, Mapping)
                 and bool(sources.catalog) and isinstance(sources.receipt, Mapping)
                 and isinstance(sources.text, str) and bool(sources.text), "complete_sources_required", "unsupported")
        payload = _decode(sources.text)
        _require(type(chapter_number) is int and payload.get("chapter_number") == chapter_number,
                 "chapter_changed")
        _require(hashlib.sha256(sources.text.encode()).hexdigest() == sources.receipt.get("assembled_source_sha256")
                 and hashlib.sha256(payload["current_body"].encode()).hexdigest() == sources.receipt["body_sha256"]
                 and not sources.receipt.get("truncated"), "sources_changed")
        context = _source_catalog(payload, sources)
        _require(_sha(payload["previous_chapters"]) == sources.receipt["previous_sha256"]
                 and _sha(context) == sources.receipt["source_sha256"]
                 and _sha({k: v for k, v in context.items() if k != "source_selection_receipt"})
                 == sources.receipt["semantic_source_sha256"], "source_manifest_changed")
        original = _result(aggregate)
        receipt["original_aggregate_sha256"] = _sha(original.model_dump(mode="json"))
        evidence = _decode(original.raw_excerpt)
        single = evidence.get("schema_version") == "commercial-slot-evidence.v1"
        if single:
            samples = [{"sample_slot": evidence.get("sample_slot"), "valid": not original.infrastructure_failure,
                        "report": original.model_dump(mode="json")}]
            n = 1
        else:
            _require(evidence.get("schema_version") == "chapter-quality-aggregation.v1",
                     "unsupported_aggregate_schema", "unsupported")
            n = evidence.get("requested_samples")
            samples = evidence.get("samples")
            _require(type(n) is int and n > 1 and isinstance(samples, list) and len(samples) == n,
                     "cohort_size_changed")
            _require(evidence.get("chapter_number") == chapter_number, "aggregate_chapter_changed")
        expected_slots = [f"chapter-quality.independent-v2:{i}" for i in range(n)]
        _require([s.get("sample_slot") for s in samples] == expected_slots, "slot_set_changed")
        if verified_quarantine_slots is not None:
            quarantined = {sample["sample_slot"] for sample in samples
                if _decode(_result(sample["report"]).raw_excerpt).get("schema") == _QUARANTINE}
            _require(isinstance(verified_quarantine_slots, Mapping)
                     and set(verified_quarantine_slots) == quarantined, "quarantine_proof_set_changed")
        domains, slots, results, contracts = {}, [], [], []
        for sample in samples:
            verified = verified_quarantine_slots.get(sample["sample_slot"]) if verified_quarantine_slots is not None else None
            result, contract = _slot(sample["report"], sample["sample_slot"], sources, domains, slots, verified)
            _require(type(sample.get("valid")) is bool and sample["valid"] == (not result.infrastructure_failure),
                     "sample_validity_changed")
            results.append(result)
            contracts.append(contract)
        _require(all(c == contracts[0] for c in contracts), "cohort_policy_changed")
        quarantine_contexts = {(s["scope_id"], s["cohort_key"]) for s in slots if s.get("quarantine_proof_sha256")}
        _require(len(quarantine_contexts) <= 1, "quarantine_cohort_changed")
        answered = [r for r in results if not r.infrastructure_failure]
        quorum = n // 2 + 1
        _require(len(answered) >= quorum, "insufficient_verified_quorum", "unsupported")
        if not single:
            _require(evidence.get("status") == "aggregated" and evidence.get("valid_samples") == len(answered)
                     and evidence.get("required_valid_samples") == quorum, "quorum_changed")
            overall = statistics.median(r.overall_score for r in answered)
            keys = set().union(*(r.dimension_scores for r in answered))
            dims = {k: statistics.median(r.dimension_scores[k] for r in answered if k in r.dimension_scores) for k in keys}
            rep = min(answered, key=lambda r: abs(r.overall_score - overall))
            rep_slot = next(i for i, r in enumerate(results) if r is rep)
            critical_slots = [expected_slots[i] for i, r in enumerate(results) if not r.infrastructure_failure and r.has_critical]
            blockers = list(rep.blocking_issues)
            for r in answered:
                for issue in r.blocking_issues:
                    if issue.severity == "critical" and issue not in blockers:
                        blockers.append(issue)
            minimum, thresholds = evidence.get("min_overall"), evidence.get("min_dimensions")
            _require(minimum == contracts[0]["min_overall"] and thresholds == contracts[0]["min_dimensions"],
                     "aggregate_thresholds_changed")
            passed = overall >= minimum - 1e-6 and all(dims.get(k, 0.0) >= v - 1e-6 for k, v in thresholds.items()) and not critical_slots
            expected = rep.model_copy(update={"passed": passed, "overall_score": float(overall),
                                               "dimension_scores": dims, "blocking_issues": tuple(blockers)})
            _require(_typed(expected) == _typed(original) and original.llm_run_id == rep.llm_run_id,
                     "aggregate_domain_changed")
            _require(evidence.get("representative_sample_slot") == expected_slots[rep_slot]
                     and evidence.get("critical_sample_slots") == critical_slots
                     and evidence.get("median_overall") == overall and evidence.get("median_dimensions") == dims
                     and evidence.get("passed") is passed, "aggregate_receipt_changed")
        output = original.model_dump(mode="json", by_alias=True)
        output.update(blocking_issues=[], audit_issues=[])
        actions = []
        entries = [(group, index, issue.model_dump(mode="json"))
                   for group in ("blocking_issues", "audit_issues") for index, issue in enumerate(getattr(original, group))]
        represented = {_json(issue) for _, _, issue in entries}
        entries.extend((None, None, json.loads(key)) for key in domains if key not in represented)
        for group, index, typed in entries:
            issue = LLMQualityIssue.model_validate(typed)
            lineage = domains.get(_json(typed), [])
            _require(bool(lineage), "issue_without_raw_lineage", "unsupported")
            kinds = {row["issue"]["assessment_kind"] for row in lineage}
            _require(len(kinds) == 1, "ambiguous_issue_authority", "unsupported")
            kind = next(iter(kinds))
            full = deepcopy(lineage[0]["issue"])
            action = "block" if group == "blocking_issues" else "audit_only"
            reason = "verified_factual_or_explicit_rule_action_unchanged"
            if kind == "narrative_quality":
                registered = get_quality_contract(issue.code)
                craft = registered is not None and (registered.domain in _CRAFT_DOMAINS or issue.code == "OPENING_SCENE_DRIFT")
                action = resolve_mode(issue.code, gate_config, chapter_no=chapter_number) if craft else "audit_only"
                reason = "registered_craft_write_gate" if craft else "narrative_has_no_canon_authority"
            row = {"aggregate_group": group, "aggregate_index": index, "assessment_kind": kind,
                   "code": issue.code, "severity": issue.severity, "effective_action": action,
                   "authority": ("craft_only" if kind == "narrative_quality" else
                                 "retained_evaluation_policy" if kind == "retained_threshold_policy" else "verified_source"),
                   "reason": reason, "lineage": deepcopy(lineage)}
            actions.append(row)
            full["action_receipt_index"] = len(actions) - 1
            output["blocking_issues" if action == "block" else "audit_issues"].append(full)
        output["has_critical"] = any(i["severity"] == "critical" for i in output["blocking_issues"])
        receipt.update(status="projected", old_policy=deepcopy(contracts[0]),
                       new_policy={"version": POLICY, "registry_version": QUALITY_CONTRACT_VERSION,
                                   "gate_config_sha256": _sha({"default": gate_config.default,
                                                               "mode_by_violation": dict(gate_config.mode_by_violation)})},
                       source_binding={k: sources.receipt[k] for k in _BINDING},
                       source_text_sha256=hashlib.sha256(sources.text.encode()).hexdigest(),
                       slots=slots, issue_actions=actions,
                       unknown_sample_slots=[s["sample_slot"] for s in slots if s["status"] == "unknown"],
                       original_has_critical=original.has_critical,
                       effective_blocking_count=len(output["blocking_issues"]),
                       scalar_pass_preserved=original.passed,
                       action_semantics="current-review-only; raw pass is not a new effective verdict")
        receipt["projection_sha256"] = _sha(output)
        return output, receipt
    except _Reject as exc:
        receipt.update(status=exc.status, reason=exc.reason)
    except (KeyError, TypeError, ValueError, AttributeError, OverflowError, RecursionError):
        receipt.update(status="blocked", reason="malformed_projection_evidence")
    return None, receipt
