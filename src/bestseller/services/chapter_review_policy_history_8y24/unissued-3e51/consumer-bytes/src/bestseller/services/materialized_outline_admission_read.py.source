"""Read existing hard-admission evidence for a negatively reviewed legacy plan."""

from __future__ import annotations

from collections.abc import Mapping, Sequence
from copy import deepcopy
from types import SimpleNamespace
from uuid import NAMESPACE_URL, UUID, uuid5

from sqlalchemy import inspect, select
from sqlalchemy.ext.asyncio import AsyncSession

from bestseller.domain.enums import ArtifactType
from bestseller.infra.db.models import (
    ChapterModel,
    PlanningArtifactVersionModel,
    ProjectModel,
    SceneCardModel,
    WorkflowRunModel,
)
from bestseller.services import chapter_outline_readiness, planning_draft_admission
from bestseller.services.conception_snapshots import snapshot_hash
from bestseller.services.foundation_selection import load_selected_foundation_artifacts
from bestseller.services.planner import _without_planning_meta
from bestseller.services.prompt_source_policy import content_hash
from bestseller.settings import AppSettings

SCHEMA = "materialized-outline-source-admission.v1"
WORKFLOW_TYPE = "materialized_outline_source_admission"
_MATERIALIZER = "materialize_chapter_outline_batch"
_REPORTS = ("outline_llm_commercial_judge", "outline_reader_experience_judge")


def _require(ok: object, reason: str) -> None:
    if not ok:
        raise ValueError(f"outline_source_admission_required:{reason}")


def admission_workflow_id(project_id: UUID, artifact_id: UUID) -> UUID:
    return uuid5(NAMESPACE_URL, f"bestseller:{SCHEMA}:{project_id}:{artifact_id}")


def _columns(model: type) -> list:
    return [getattr(model, field.key).label(field.key) for field in inspect(model).column_attrs]


async def _row(session: AsyncSession, model: type, identity: UUID) -> SimpleNamespace | None:
    # Column reads bypass the identity map without refreshing caller-owned
    # dirty objects. The public boundary suppresses autoflush throughout.
    result = await session.execute(select(*_columns(model)).where(model.id == identity))
    row = result.mappings().one_or_none()
    return SimpleNamespace(**row) if row is not None else None


def _negative(metadata: object) -> bool:
    if not isinstance(metadata, Mapping):
        return False
    negative = False
    for name in _REPORTS:
        report = metadata.get(name)
        if report is None:
            continue
        _require(isinstance(report, Mapping), "historical_report_malformed")
        for flag in ("pass", "passed", "has_critical"):
            if flag in report:
                _require(type(report[flag]) is bool, "historical_report_malformed")
        issues = report.get("blocking_issues", [])
        _require(
            isinstance(issues, (list, tuple)) and all(isinstance(i, Mapping) for i in issues),
            "historical_report_malformed",
        )
        negative |= (
            report.get("pass") is False
            or report.get("passed") is False
            or report.get("has_critical") is True
            or any(i.get("severity") == "critical" for i in issues)
        )
    return negative


async def _foundation(
    session: AsyncSession,
    settings: AppSettings,
    project: SimpleNamespace,
    receipt: Mapping,
    state: Mapping,
) -> dict:
    selected = await load_selected_foundation_artifacts(session, project=project, settings=settings)
    all_kinds = {"book_spec", "world_spec", "cast_spec", "volume_plan"}
    _require(
        isinstance(selected, Mapping) and set(selected) == all_kinds, "selected_foundation_required"
    )
    _require(
        isinstance(state.get("foundation"), Mapping) and set(state["foundation"]) == all_kinds,
        "full_foundation_binding_missing",
    )
    binding = {}
    for kind, source in selected.items():
        current = await _row(session, PlanningArtifactVersionModel, source.id)
        _require(
            current is not None
            and current.project_id == project.id
            and current.artifact_type == kind
            and current.status == "approved"
            and current.scope_ref_id is None
            and content_hash(current.content) == content_hash(source.content),
            f"foundation_not_current:{kind}",
        )
        binding[kind] = {"id": str(current.id), "content_hash": content_hash(current.content)}
    _require(
        content_hash(state["foundation"]) == content_hash(binding), "selected_foundation_changed"
    )
    expected = receipt.get("foundation_hashes")
    kinds = (ArtifactType.BOOK_SPEC, ArtifactType.WORLD_SPEC, ArtifactType.CAST_SPEC)
    _require(
        isinstance(expected, Mapping) and set(expected) == {k.value for k in kinds},
        "foundation_binding_missing",
    )
    contents = {}
    for kind in kinds:
        source = selected[kind.value]
        _require(source is not None, f"foundation_missing:{kind.value}")
        current = await _row(session, PlanningArtifactVersionModel, source.id)
        _require(
            current is not None
            and current.project_id == project.id
            and current.artifact_type == kind.value
            and current.status == "approved"
            and current.scope_ref_id is None
            and isinstance(current.content, Mapping)
            and bool(current.content),
            f"foundation_not_current:{kind.value}",
        )
        binding = {
            "artifact_id": str(current.id),
            "version": current.version_no,
            "content_hash": content_hash(current.content),
        }
        _require(
            content_hash(expected[kind.value]) == content_hash(binding)
            and content_hash(source.content) == binding["content_hash"],
            f"foundation_changed:{kind.value}",
        )
        contents[kind.value] = deepcopy(current.content)
    return contents


async def require_materialized_outline_source_admission(
    session: AsyncSession,
    settings: AppSettings,
    *,
    project: ProjectModel,
    artifact: PlanningArtifactVersionModel,
    chapter: ChapterModel | None = None,
    scenes: Sequence[SceneCardModel] | None = None,
) -> dict | None:
    """Require current hard proof only for legacy plans with negative reviews.

    Negative commercial/reader grades trigger proof, never become hard codes.
    This consumer creates no workflow, grade, prefix marker or model request.
    """
    with session.no_autoflush:
        try:
            fresh_chapter = None
            if chapter is not None:
                fresh_chapter = await _row(session, ChapterModel, chapter.id)
                _require(fresh_chapter is not None and fresh_chapter.project_id == project.id
                    and chapter.project_id == project.id, "source_plan_projection_scope")
                actual_meta, cached_meta = fresh_chapter.metadata_json or {}, chapter.metadata_json or {}
                if "outline_source_admission" in actual_meta or "outline_source_admission" in cached_meta:
                    from bestseller.services.rewrite_outline_binding import validate_source_plan_binding
                    actual_marker = validate_source_plan_binding(actual_meta.get("outline_source_admission"))
                    _require(cached_meta.get("outline_source_admission") == actual_marker
                        and actual_marker["artifact_id"] == str(artifact.id), "current_marker_changed")
            current = await _row(session, PlanningArtifactVersionModel, artifact.id)
            _require(
                current is not None
                and current.project_id == project.id
                and artifact.project_id == project.id
                and current.status == "approved"
                and current.artifact_type == ArtifactType.CHAPTER_OUTLINE_BATCH.value
                and isinstance(current.content, dict),
                "artifact_scope_or_status",
            )
            _require(
                content_hash(artifact.content) == content_hash(current.content), "artifact_changed"
            )
            meta = current.content.get("_meta") or {}
            _require(isinstance(meta, Mapping), "artifact_metadata_malformed")
            producer = (
                await _row(session, WorkflowRunModel, current.source_run_id)
                if current.source_run_id
                else None
            )
            if "sourcebound_readiness_receipt" in meta or (
                producer is not None and producer.workflow_type == "approve_chapter_outline_prefix"
            ):
                return await chapter_outline_readiness.verify_outline_prefix_readiness(
                    session,
                    project=project,
                    artifact_id=current.id,
                    chapter=chapter,
                    scenes=scenes,
                    settings=settings,
                )

            rows = (
                (
                    await session.execute(
                        select(*_columns(WorkflowRunModel)).where(
                            WorkflowRunModel.project_id == project.id,
                            WorkflowRunModel.workflow_type == _MATERIALIZER,
                            WorkflowRunModel.status == "completed",
                            WorkflowRunModel.scope_type == "planning_artifact",
                            WorkflowRunModel.scope_id == current.id,
                        )
                    )
                )
                .mappings()
                .all()
            )
            negatives = [row for row in rows if _negative(row["metadata_json"])]
            marker = ((getattr(chapter, "metadata_json", None) or {}).get("outline_source_admission")
                if chapter is not None else None)
            full_revision = "full_outline_revision" in meta or (
                producer is not None and producer.workflow_type == WORKFLOW_TYPE
            ) or isinstance(marker, Mapping)
            if not negatives and not full_revision:
                return None

            workflow_id = admission_workflow_id(project.id, current.id)
            workflow = await _row(session, WorkflowRunModel, workflow_id)
            _require(workflow is not None, "current_hard_admission_missing")
            _require(
                workflow.project_id == project.id
                and workflow.workflow_type == WORKFLOW_TYPE
                and workflow.scope_type == "planning_artifact"
                and workflow.scope_id == current.id
                and workflow.status == "completed",
                "current_hard_admission_scope_or_status",
            )
            if full_revision:
                _require(current.source_run_id == workflow_id, "full_revision_actual_producer")
            state = workflow.metadata_json
            _require(
                isinstance(state, Mapping) and state.get("schema") == SCHEMA,
                "current_hard_admission_metadata",
            )
            candidate = deepcopy(_without_planning_meta(current.content))
            _require(
                state.get("source_artifact_id") == str(current.id)
                and state.get("source_content_sha256") == content_hash(current.content)
                and state.get("candidate_hash") == content_hash(candidate),
                "source_binding_changed",
            )
            _require(
                state.get("materialization_workflow_run_id") in {
                    str(r["id"]) for r in (rows if full_revision else negatives)},
                "materialization_binding_changed",
            )
            receipt = state.get("source_admission")
            _require(
                isinstance(receipt, Mapping) and receipt.get("draft_eligible") is True,
                "current_hard_admission_not_eligible",
            )
            fresh_project = await _row(session, ProjectModel, project.id)
            _require(fresh_project is not None, "project_missing")
            for key, metadata_key in (
                ("canonical_id", "creation_canonical_snapshot_id"),
                ("canonical_hash", "creation_canonical_snapshot_hash"),
            ):
                _require(
                    isinstance(state.get(key), str)
                    and bool(state[key])
                    and state[key] == (fresh_project.metadata_json or {}).get(metadata_key),
                    "canonical_binding_changed",
                )
            canonical = await _row(
                session, PlanningArtifactVersionModel, UUID(state["canonical_id"])
            )
            _require(
                canonical is not None
                and canonical.project_id == project.id
                and canonical.artifact_type == "conception_snapshot"
                and canonical.status == "canonical"
                and canonical.scope_ref_id is None
                and snapshot_hash(canonical.content) == state["canonical_hash"],
                "canonical_source_changed",
            )
            contents = await _foundation(session, settings, fresh_project, receipt, state)
            verified = await planning_draft_admission.verify_planning_draft_admission(
                session,
                project=fresh_project,
                workflow_run_id=workflow_id,
                candidate_payload=candidate,
                book_spec=contents["book_spec"],
                world_spec=contents["world_spec"],
                cast_spec=contents["cast_spec"],
                receipt=receipt,
                settings=settings,
            )

            projection = None
            if chapter is not None:
                _require(
                    chapter.project_id == project.id and scenes is not None,
                    "source_plan_projection_scope",
                )
                _require(
                    all(
                        s.project_id == project.id
                        and s.chapter_id == chapter.id
                        and type(s.scene_number) is int
                        for s in scenes
                    ),
                    "source_plan_projection_scope",
                )
                number = chapter.chapter_number
                _require(type(number) is int, "source_plan_projection_chapter")
                chapters = candidate.get("chapters")
                _require(isinstance(chapters, list), "source_plan_projection_candidate")
                matches = [
                    c
                    for c in chapters
                    if isinstance(c, Mapping)
                    and type(c.get("chapter_number")) is int
                    and c["chapter_number"] == number
                ]
                _require(len(matches) == 1, "source_plan_projection_chapter")
                from bestseller.services.retained_planning_generation import _Reader
                fresh_scenes = sorted(await _Reader(session).rows(SceneCardModel,
                    SceneCardModel.chapter_id == chapter.id), key=lambda item: item.scene_number)
                _require(all(item.project_id == project.id for item in fresh_scenes)
                    and {item.id for item in scenes} == {item.id for item in fresh_scenes}
                    and len(scenes) == len(fresh_scenes), "source_plan_projection_scope")
                projection = chapter_outline_readiness.outline_prefix_projection_hash(
                    fresh_chapter, fresh_scenes
                )
                _require(chapter_outline_readiness.outline_prefix_projection_hash(chapter, scenes)
                    == projection, "source_plan_projection_caller_stale")
                chapter_outline_readiness._verify_materialized_content(
                    fresh_chapter, fresh_scenes, matches[0])
                if full_revision:
                    from bestseller.services.rewrite_outline_binding import validate_source_plan_binding
                    expected_marker = {"artifact_id": str(current.id),
                        "workflow_run_id": str(workflow_id), "projection_hash": projection,
                        "source_content_sha256": content_hash(current.content)}
                    _require(fresh_chapter is not None
                        and fresh_chapter.project_id == project.id
                        and validate_source_plan_binding(marker) == expected_marker
                        and (fresh_chapter.metadata_json or {}).get("outline_source_admission")
                            == expected_marker, "full_revision_current_marker")
                if "chapter_projection_hashes" in state:
                    saved = state["chapter_projection_hashes"]
                    _require(
                        isinstance(saved, Mapping) and saved.get(str(chapter.id)) == projection,
                        "source_plan_projection_changed",
                    )
            else:
                _require(scenes is None, "source_plan_projection_chapter_missing")
                if full_revision:
                    # Whole-plan/completed recovery reads must prove every
                    # current projection and marker, just as chapter entries do.
                    from bestseller.services.materialized_outline_source_recovery import _read_sources
                    from bestseller.services.retained_planning_generation import _Reader
                    from bestseller.services.rewrite_outline_binding import validate_source_plan_binding
                    _, _, _, _, current_binding = await _read_sources(session, settings,
                        project_slug=fresh_project.slug, artifact_id=current.id,
                        materialization_workflow_id=UUID(state["materialization_workflow_run_id"]))
                    _require(all(content_hash(state.get(key)) == content_hash(value)
                        for key, value in current_binding.items()), "full_source_projection_changed")
                    chapters = await _Reader(session).rows(ChapterModel,
                        ChapterModel.project_id == project.id)
                    _require(bool(chapters), "full_source_projection_missing")
                    for item in chapters:
                        marker = validate_source_plan_binding(
                            (item.metadata_json or {}).get("outline_source_admission"))
                        _require(marker == {"artifact_id": str(current.id),
                            "workflow_run_id": str(workflow_id),
                            "source_content_sha256": content_hash(current.content),
                            "projection_hash": current_binding["chapter_projection_hashes"].get(str(item.id))},
                            "full_revision_current_marker")
            return {
                **deepcopy(dict(state)),
                "workflow_run_id": str(workflow_id),
                "source_admission": verified,
                "source_plan_projection": projection,
            }
        except (ValueError, TypeError, KeyError, AttributeError) as exc:
            if str(exc).startswith("outline_source_admission_required:"):
                raise
            raise ValueError(f"outline_source_admission_required:{exc}") from exc
